# ============================================================
#  QuantMaster Pro — Railway 환경변수 완전 설정 가이드
#  이 파일을 .env로 복사 후 실제 값을 입력하세요.
#  Railway Dashboard → Variables 탭에서 동일하게 설정하세요.
# ============================================================

# ──────────────────────────────────────────────
# [1] KIS (한국투자증권) API 설정
# ──────────────────────────────────────────────

# KIS 앱키 / 앱시크릿 (KIS Developers → 앱 등록 후 발급)
# 처음에는 모의투자(VTS) 계좌 앱키를 사용하세요
KIS_APP_KEY=PSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIS_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 계좌번호 — 앞 8자리만 입력 (예: 50123456)
KIS_ACCOUNT_NO=50123456

# 계좌 상품코드 — 일반적으로 01
KIS_ACCOUNT_PROD=01

# true = 실거래, false = 모의투자(VTS)
# ⚠️ 처음에는 반드시 false로 시작하세요!
KIS_IS_REAL=false

# ──────────────────────────────────────────────
# [1-B] 실계좌 데이터 전용 키 (하이브리드 구조, 선택)
# ──────────────────────────────────────────────
# 모의계좌(VTS)로 주문을 집행하면서, 실계좌 키로 시장 데이터를 조회합니다.
# 거래량 순위, 상승률 순위 등 실계좌에서만 제공하는 데이터에 사용됩니다.
# ※ 주문은 절대 실행하지 않으며, 데이터 조회(GET)만 수행합니다.
# ※ 미설정 시 모의계좌 키로 자동 폴백합니다.
KIS_REAL_DATA_APP_KEY=
KIS_REAL_DATA_APP_SECRET=

# ──────────────────────────────────────────────
# [2] 자동매매 제어 설정
# ──────────────────────────────────────────────

# 서버사이드 자동매매 활성화 여부
# Shadow 모드로 충분히 검증한 후 true로 변경하세요
AUTO_TRADE_ENABLED=false

# 클라이언트-서버 중복 주문 방지 플래그
# AUTO_TRADE_ENABLED=true로 설정할 때 이 값도 true로 맞추세요.
# true이면 클라이언트(브라우저)에서의 실주문이 차단되고
# 서버 autoTradeEngine만 주문을 집행합니다.
VITE_AUTO_TRADE_ENABLED=false

# ──────────────────────────────────────────────
# [2-A] 실행 모드 & 모의(VTS) 매매 (ADR-0553)
# ──────────────────────────────────────────────
# 실행 방향: SHADOW(가상, 기본) / LIVE(실제 주문 집행) / VTS(=PAPER 매핑). 미설정 시 SHADOW.
# "주문을 낼지(아래 mode)" 와 "어느 계좌인지(KIS_IS_REAL)" 는 직교 2축:
#   · 모의(VTS) 매매 = AUTO_TRADE_MODE=LIVE + KIS_IS_REAL=false + VTS_PAPER_TRADING_ENABLED=true
#   · 실계좌  매매   = AUTO_TRADE_MODE=LIVE + KIS_IS_REAL=true  + KIS_REAL_MONEY_ACK=true
AUTO_TRADE_MODE=SHADOW

# [ADR-0553] 모의(VTS) 매매 대칭 활성화. default 미설정(false).
# true + (AUTO_TRADE_MODE=LIVE & KIS_IS_REAL=false) 일 때만 모의계좌로 매수·매도가 대칭 집행됩니다.
# 미설정 시 LIVE+모의 조합은 기동 거부 — 매수만 나가고 매도가 차단되는 비대칭을 막습니다.
# ⚠️ 실제 돈 위험 없음 — KIS_IS_REAL=false 이므로 모의계좌(VTS)에만 주문이 나갑니다.
VTS_PAPER_TRADING_ENABLED=false

# [ADR-0553] 실계좌(실제 돈) 매매 명시 승인. default 미설정(false).
# AUTO_TRADE_MODE=LIVE + KIS_IS_REAL=true 일 때 이 값이 true 가 아니면 서버 기동을 거부합니다.
# 🔴 실수로 실거래가 켜지는 것을 막는 하드가드 — 실거래 의도가 확실할 때만 true.
KIS_REAL_MONEY_ACK=false

# 서버 자동매매 투자 총자산 (원) — 미설정 시 1억원 기본값
# 모의계좌 초기자금에 맞춰 설정하세요 (예: 3천만원 = 30000000)
AUTO_TRADE_ASSETS=30000000

# ⚠️ [미소비 — 2026-06-10 감사] MAX_POSITION_PCT 는 코드 어디서도 읽지 않는다 (착시 주의).
# 실제 1회 포지션 상한은 레짐별 sizing 정책 상수(server/trading/sizing/* maxPositionPct 0.10 등)와
# PositionSizingEngine 이 결정한다 — 본 변수를 바꿔도 동작 무변. ENV 노출이 필요하면 별도 wiring PR.
# MAX_POSITION_PCT=10

# 일일 손실 한도 (총 자산 대비 %) — 초과 시 긴급 자동 정지
DAILY_LOSS_LIMIT=5

# PR-22 / ADR-0008 — Kelly 시간감쇠 wiring 스위치.
# false 로 두면 accountRiskBudget 가 timeDecayInput 을 받아도 staticKelly 로 단락. 긴급 롤백용.
# KELLY_TIME_DECAY_ENABLED=true

# PR-22 / ADR-0007 — 학습 모듈 하이브리드 suggest 알림 스위치.
# false 로 두면 counterfactual/ledger/kellySurface/regimeCoverage suggest 알림이 전부 차단됨.
# LEARNING_SUGGEST_ENABLED=true

# ADR-0546 Phase 1 — Gate1 required score 레짐 인식 스위치 (default OFF, 동작 보존).
# false(기본): 모든 레짐에서 레거시 70 반환 → live/diagnostic 결과 0 변화.
# true: resolveGate1RequiredScore 가 getEffectiveGateThreshold(regime)×10 반환 (R3_EARLY→40~60).
# Phase 2(운영자 승인 + forward-outcome 검증) 전까지 false 유지. 'false' 1줄로 즉시 롤백.
# GATE1_REGIME_AWARE_REQUIRED=false

# Gate1 관측 ledger top-N 확대 (2026-06-11 점수 스케일 정합 patch 동반, 1~500 정수).
# 미설정(기본): 기존 default 보존 — V2 관측 top-10 · near-miss/universe top-5.
# 설정 시: 평가 후보 전수 forward outcome 관측 가능 (예: 50 → 41/41 기록). fetch 0·quota 0,
# 디스크(ledger json, max 2000행 rolling)만 증가. executionImpact=NONE (관측 전용).
# GATE1_OBSERVATION_TOP_N=50

# ADR-0598 — 과열 추격 가드 갭 봉인 2종 (정확 비교 === 'true', default OFF byte-equivalent).
# G1: 진입 시점 5거래일 +15% 재평가 — OFF 시 등록 시점 1회 평가만(기존) + [REGRET_ENTRY_REEVAL_OBSERVE]
#   would-cooldown 관측 로그. ON 시 진입 게이트에서 쿨다운 신규 발동(48h/되돌림 해제, 기존 의미론).
# REGRET_ENTRY_REEVALUATION_ENABLED=false
# G2: Gate3 이격 검증불가(ma20 결손) 시 BREAKOUT_CONFIRMED 확정 보류 — OFF 시 기존 동작 +
#   EXTENSION_UNVERIFIABLE_MA20_MISSING_OBSERVE note 만. ON 시 NOT_CONFIRMED(WAIT) → live 매수만
#   보수화, shadow 무영향(불변식 #8). 롤백 각 1줄.
# GATE3_EXTENSION_GUARD_STRICT_ENABLED=false

# ADR-0599 — Gate2 confluence 가용 축 비례 요구 (정확 비교, default OFF byte-equivalent).
# 결손 축이 STRONG/WEAK 절대 개수 조건(bullish>=3)을 역설적으로 강화하는 갭 보정 — ON 시 요구
# 개수=ceil(가용축×60%) (5축=3 동일, 3축=2). 점수 임계 80/65·BULLISH 컷 85 불변. OFF 시에도
# /scan_blockers_gate2 에 proportionalDryRun: strong=N weak=M 관측 1줄 상시 출력. 롤백 1줄.
# GATE2_PROPORTIONAL_BULLISH_ENABLED=false

# ADR-0600 — Gate2 Supply/Sector 결손 축 보수 fallback (default ON, `!== 'false'` — 진단 차선 한정).
# Supply: KIS 투자자행 결손 시 Gate1 시맨틱 수급(BULLISH 78 캡/NEUTRAL 50/BEARISH 30, DEGRADED).
# Sector: 업종지수 결손 시 스캔 내 동종군(n>=3) 상대수익(최대 62, BULLISH 불가). UNKNOWN/동종군 부족 → missing 유지.
# 네이티브 1순위 후속(ADR-0601): KIS inquire-investor + KOSDAQ 마스터 업종코드. =false 1줄 롤백.
# GATE2_AXIS_COVERAGE_FALLBACK_ENABLED=true

# ADR-0621 — Gate2 RS 벤치마크 이원화 (KOSDAQ 종목 KOSDAQ 지수 20일 수익률 벤치마크, default OFF byte-equivalent).
# 코스피 강세/코스닥 약세 디버전스 국면에서 코스닥 주도주가 KOSPI 대비 RS 압축으로 STRONG 0건 나는 문제 해소.
# ON 시 KOSDAQ 종목 RS excess = stockReturn − kosdaq20dReturn (benchmarkReturnNormalizer 단일 통로 재사용,
# rsScoreFromExcess 구간·임계 불변). KOSPI 종목은 현행 동치. KOSDAQ source 결손 시 KOSPI fallback(불변식 #6).
# OFF 시에도 /scan_blockers_gate2 에 kosdaqBenchmarkDryRun: rsStrong=N rsAccumOrBetter=M 관측 1줄 상시 출력. 롤백 1줄.
# GATE2_RS_KOSDAQ_BENCHMARK_ENABLED=false

# ADR-0601 — Gate2 Supply 축 KIS 네이티브 hydration (default ON, `!== 'false'`). 결손 후보의 종목별
# 투자자 순매수를 기존 단일통로(fetchKisInvestorFlowEvidence)로 보충 주입. quota 3중 관리: 일중 캐시
# (재스캔 fetch 0) + 스캔당 신규 조회 상한(아래, default 16) + 당일 실패 재시도 억제. =false 1줄 롤백.
# GATE2_INVESTOR_FLOW_NATIVE_HYDRATION_ENABLED=true
# GATE2_INVESTOR_FLOW_HYDRATION_MAX=16

# ADR-0601 D4 — Gate2 Sector 축 KIS 네이티브 hydration (default ON, `!== 'false'`). 종목 마스터
# (kospi/kosdaq_code.mst 일 1회 다운로드·캐시)의 지수업종 중분류 코드→업종지수 일봉 r20 으로
# sectorCycle 결손 보충(PARTIAL·DEGRADED). 업종지수 조회는 고유 업종코드 단위(일중 캐시+스캔당
# 상한 default 12+실패 억제). 공식 11-섹터 이름 매핑 우회 — 코스닥 포함 전 종목 커버. =false 1줄 롤백.
# GATE2_SECTOR_CYCLE_NATIVE_HYDRATION_ENABLED=true
# GATE2_SECTOR_INDEX_FETCH_MAX=12

# ADR-0602 Phase 0 — 섹터 한도 차단 시 "동일 섹터 약자→강자 교체" 관측 제안 (default ON, `!== 'false'`).
# 표시·기록 전용(실집행 0) — 가드 차단 텔레그램에 교체 후보 1줄 표기 + counterfactual 데이터로
# Phase 1(shadow 교체 집행) 판정. =false 1줄 롤백(가드 메시지 byte-equivalent).
# TRADE_REPLACEMENT_OBSERVE_ENABLED=true

# ADR-0602 Phase 1 — shadow 교체 집행 (정확 비교 === 'true', default OFF). ON + 제안 발생 시
# shadow 장부 안에서만 약자 청산(SECTOR_REPLACEMENT_EXIT) + 신규 shadow 생성. 게이트 차단 결정과
# live 주문 경로는 무변경(mode='LIVE' trade 무접촉, 불변식 #8). 일일 집행 상한 기본 2 (0~10).
# TRADE_REPLACEMENT_SHADOW_EXECUTE_ENABLED=false
# TRADE_REPLACEMENT_DAILY_MAX=2

# ADR-0603 — 미국 지수 KIS-primary 승격 (default ON, `!== 'false'`). SPX 일봉을 KIS 해외지수
# API(FHKST03030100, 일캐시 ~지수당 1콜/일)로 우선 조회, 실패 시 기존 Yahoo fallback 보존.
# NDX(나스닥100)는 관측 전용 수집(macroState.ndxDayReturn — 레짐 미소비). ISCD 가 KIS 마스터와
# 다르면 아래 ENV 로 재배포 없이 정정. =false 1줄 롤백(Yahoo 100% 복원).
# KIS_OVERSEAS_INDEX_DAILY_ENABLED=true
# KIS_OVERSEAS_SPX_ISCD=SPX
# KIS_OVERSEAS_NDX_ISCD=NDX
# ADR-0605 — 필라델피아 반도체(SOX) 관측 수집 + Gate2 반도체 proxy 축 입력. KIS 마스터 코드가
# 다르거나 미지원이면 ENV 정정/자동 무시(null 격리 — 결손은 어떤 신호로도 변환 안 됨).
# KIS_OVERSEAS_SOX_ISCD=SOX

# ADR-0605 D2 — Gate2 반도체 후보의 잔존 sectorCycle 결손을 SOX 20일 수익 proxy 로 보충
# (정확 비교 === 'true', default OFF). stockVsSector 단독 주입 → 최대 62 자연 캡(BULLISH 민팅 불가).
# GATE2_SOX_SECTOR_AXIS_ENABLED=false

# ADR-0623 Stage 2 — PriceCorrection shadow corrected 채택 활성화 (정확 비교 === 'true', default OFF).
# OFF(기본) = corrected 값을 shadow 판단에 미채택 = Stage 1 동작 byte-equivalent.
# 본 PR 구현 범위 = Stage 2a (ENV + Seam A diagnostics 집계 채움). Stage 2b(shadow corrected 치환)는 후속 PR.
# PRICE_CORRECTION_DISABLED=true 가 우선 — disabled 시 shadow 활성화도 자동 생략.
PRICE_CORRECTION_SHADOW_ENABLED=false

# ADR-0604 3단계 — 미국 야간 급락 시 개장 전 보수 강등 (정확 비교 === 'true', default OFF).
# ON + SPX 야간 < 임계(-2.5% 기본) 시: bias -12 + R6 회복 가속(decay floor) 차단. 활성화 기준:
# /us_overnight 의 <-2% 밴드 n>=10 + KOSPI 평균 음수 실측 확인 후 (2단계 stratify 가 근거).
# US_OVERNIGHT_DEFENSE_ENABLED=false
# US_OVERNIGHT_DEFENSE_THRESHOLD_PCT=-2.5

# ADR-0611 — Gate1 SECTOR_RELATIVE_STRENGTH 컴포넌트 재활성 (ADR-0643 default ON 승격 2026-06-22, 패턴 `!== 'false'`).
# 배경: 활성 maxScore 합(108)이 requiredScore=70 calibrate 기준 configuredPositiveMax(116)보다 8점 낮음
#   — ADR-0467 이 본 컴포넌트를 advisory-only(maxScore:0)로 주차한 의도치 않은 side effect(상위 8점 봉인).
# ON(기본): 8pt 복원, 섹터상대수익(stock−sector 20d)만 소비(RS 시장상대와 이중계상 회피), 입력 부재 graceful 0.
#   requiredScore=70 무변경·신규 fetch 0.
#   executionImpact≠NONE: 섹터 강세 종목 Gate1 통과 분포 상승 가능(의도된 LIVE 효과, 운영자 승인).
# 롤백: =false 명시 → maxScore 0·weightedScore 0(advisory-only) byte-equivalent 1줄 롤백.
# GATE1_SECTOR_RS_COMPONENT_ENABLED=true

# ADR-0612 — 유니버스 선정 시장상대강도(RS) 게이트 (정확 비교 === 'true', default OFF).
# 배경: 강세장(KOSPI 20일 +7.5%)인데 발굴·Stage1이 절대수익만 봐서 후보가 낙폭과대 반등주
#   (시장 대비 -9% 언더퍼폼)로 채워짐. RS는 Gate1 채점엔 있으나 선정 단계엔 없어 주도주가 후보 풀 미유입.
# ON: ① 발굴 MOMENTUM에서 momentum20d≥KOSPI20d 필터(생존 부족 시 미적용·후보 0 방지)
#     ② Stage1 risk-on 점수에 clamp(종목20d−KOSPI20d, 0, 3) 0-floor 보너스(시장 못 이기면 0).
#   벤치마크=macroState.kospi20dReturn(신규 fetch 0). requiredScore=70·Gate 산식 무변경.
# OFF(기본): 발굴·Stage1 byte-equivalent. =false/미설정 1줄 롤백.
# UNIVERSE_RS_GATE_ENABLED=false

# ADR-0617 — 주도주 Stage1 보존 (정확 비교 === 'true', default OFF).
# 배경: 발굴 후보가 낙폭반등 laggard 로 편향 — 외인·기관·시총 상위 주도주가 top-N 점수컷 밖으로 밀림.
# ON: ① expandedUniverse source 태그(FOREIGN_NET_BUY/INST_NET_BUY/MARKET_CAP) carry
#     ② top-N 컷 밖 주도주를 union 보존(비주도 후보 미희생·품질 관문 유지·점수-랭크 컷만 우회). 신규 fetch 0.
# 권고: LEADER_DAILY_REFRESH_ENABLED 와 동시 ON (단독 ON 시 stale leader 최대 14일 보존 위험 — 신선화와 짝).
# OFF(기본): scanUniverse 구성·top-N 컷 byte-equivalent. =false/미설정 1줄 롤백.
# LEADER_UNIVERSE_INJECTION_ENABLED=false

# ADR-0618 — 주도주 유니버스 일일 신선화 (정확 비교 === 'true', default OFF).
# ON: cron leader_universe_daily_refresh(KST 08:10·거래일만) 가 외인·기관·시총 주도주 유니버스 재수집.
#   LEADER_UNIVERSE_INJECTION_ENABLED 보존과 짝(stale leader 방지). 신규 fetch 는 cron 수집 경로(발굴 본체 fetch 0).
# OFF(기본): cron no-op(신선화 미수행). =false/미설정 1줄 롤백.
# LEADER_DAILY_REFRESH_ENABLED=false

# ADR-0550 — Stage1 risk-on 레짐 주도주 캡처 (정확 비교 === 'true', default OFF).
# ON: OVERHEAT/OVEREXTENDED 레짐에서 risk-on 분기일 때 Stage1 캡 완화(주도주 과열 컷 면제 일부).
#   requiredScore=70·Gate 산식 무변경·신규 fetch 0.
# OFF(기본): Stage1 캡 byte-equivalent. =false/미설정 1줄 롤백.
# STAGE1_RISK_ON_LEADER_CAPTURE_ENABLED=false

# ADR-0616 — 유니버스 구성 편향 관측 (정확 비교 === 'true', default OFF).
# ON: per-scan aggregate 로 후보의 KOSPI/KOSDAQ 비중·leader/laggard(RS)·시총 tier 분포를 ledger 기록(관측 전용).
#   RS=quote.return20d − kospi20dReturn(두 번째 공식 0). executionImpact NONE·신규 fetch 0·무음.
# OFF(기본): 관측 산출·append 진입 skip(byte-identical). =false/미설정 1줄 롤백.
# UNIVERSE_COMPOSITION_BIAS_OBSERVATION_ENABLED=false

# ADR-0622 ② — Stage1 top-N 컷 상향 (정확 비교 === 'true', default OFF).
# 배경: 발굴 Stage1 top-N 컷이 60 하드코딩 → 후보 절대수 부족(STRONG/shadow 진입 0).
# ON: top-N 컷 60→90(KIS 랭킹 raw 컷·점수컷 둘 다). budget lazy(ADR-0558) — 컷 후 fetch 유지·eager 전수 금지.
#   quota: KIS quote fetch +30/스캔(랭킹 raw 컷). KRX/Yahoo 0. 품질 희석 리스크 → ③ 와 병행 권고.
# OFF(기본): universeScanner :356/:441 컷 60 byte-identical. =false/미설정 1줄 롤백.
# UNIVERSE_STAGE1_TOPN_EXPANSION_ENABLED=false

# ADR-0622 ③ — 발굴 RS percentile 우선 정렬 + laggard 디모트 (정확 비교 === 'true', default OFF).
# 배경: 발굴 top-N 컷이 stage1Score 단독 정렬 → laggard(시장 대비 -10~-13%) 편향. RS percentile 우선 부재.
# ON: top-N 컷 정렬에 positive-RS(rs≥0) 우선 편입·laggard(rs<0) 디모트·결손 중립.
#   RS=quote.return20d − kospi20dReturn(ADR-0616 정의 재사용·두 번째 공식 0). 신규 fetch 0·주도주 union 보존 직교.
# OFF(기본): stage1Score 단독 정렬 byte-identical. =false/미설정 1줄 롤백.
# UNIVERSE_RS_PERCENTILE_RANK_ENABLED=false

# ADR-0613 — Gate1 천장 배선 (ADR-0643 default ON 승격 2026-06-22, 패턴 `!== 'false'`).
# 배경: 강세장(R3_EARLY)인데 Gate1 진입 0. positive 천장 저활용(configuredPositiveMax 116 vs
#   observedPositiveMax 49.2·utilization 42.4%) — 천장을 채울 입력(RS percentile·BREAKOUT OHLCV)·
#   정규화가 dry-run 모듈에만 있고 LIVE scorer(buildMinimumSignalScoreTrace)에 미배선이 근본 원인.
# ON(기본): ① RS percentile 입력 배선(ADR-0597 crossSectionalPercentile, dedup 정합) ② BREAKOUT_STRUCTURE
#     OHLCV 배선(resolveBreakoutStructureSource ADR-0475 재사용) ③ positive max→100 정규화(ADR-0468).
#   component maxScore·requiredScore=70·passed 판정 무변경, 끊긴 입력 배선만 복원(천장은 열되 데이터가 채움).
# executionImpact≠NONE: 결손 메워진 종목 통과↑. 단 ③ 정규화 단독은 survivors 0+netAvg 하락 가능(3종 묶음
#   순효과는 입력 커버리지 의존 — flip 직후 1~2세션 집중 관측). 통과 분포 급변 시 우선 =false 롤백.
# 롤백: =false 명시 → 3종 transform identity byte-equivalent 1줄 롤백. (관측 ledger hypothetical delta 는 항상 stamp)
# GATE1_POSITIVE_CEILING_WIRING_ENABLED=true

# ADR-0627 — Gate1 RS percentile 연속 승격 (ADR-0643 default ON 승격 2026-06-22, 패턴 `!== 'false'`).
# 배경: decompositionBuilder 가 연속 percentile(rsRankPct 0~100)을 5단 step(0/2/5/8/10)으로 양자화 →
#   p<50 전부 0, p50~60 은 2 → RS positive avg +2.5/20 starvation(이미 계산된 percentile 분해능 손실 버그).
# ON(기본): step 대신 연속 승격(clamp(rsRankPct/10, 0, 10)) — maxScore 10·weight 1·requiredScore 70·천장 116 무변경.
#   p=100 은 step·연속 동일 10(천장 무변). weight 인상 아님 — 버려지던 중간구간 분해능 손실 복원(ADR-0471 정합).
#   executionImpact≠NONE: 중하위 RS 종목 actualScore↑ → Gate1 통과 분포 미세 상승(버그픽스, 천장 무변).
# 롤백: =false 명시 → step 양자화 byte-identical 1줄 롤백. (D3 관측 hypothetical 은 항상 stamp)
# GATE1_RS_PERCENTILE_CONTINUOUS_ENABLED=true

# ADR-0640 — Gate1 결손 분모 제외 + requiredScore 비례 축소 (ADR-0643 default ON 승격 2026-06-22, 패턴 `!== 'false'`).
# ON(기본): 결손(UNKNOWN/MISSING/STALE) component maxScore 를 분모(configuredPositiveMax)에서 제외 +
#   effectiveRequiredScore 가용 분모 비례 축소(절대 인상 0·available>=configured 면 무변경·하한 0.7× clamp=49).
#   requiredScore 필드(70)는 무변경 — passed/scoreGap 만 effective 기준 평가.
#   executionImpact≠NONE: 수급/투자자 결손 종목 실효 문턱↓ → 통과↑. **데이터 만성 결손 시 게이트 완화 부작용
#   (최대 위험)** — 통과율 급증+결손률 상승 동반 시 본 flag 우선 =false 롤백(incident-playbook 진단 1순위).
# 롤백: =false 명시 → effective===requiredScore(70 고정) byte-identical 1줄 롤백.
# GATE1_DENOMINATOR_NORMALIZATION_ENABLED=true

# ADR-0578 — Gate1 기술지표 주입 스위치 (코드 default ON 승격 2026-06-06, ADR-0157 패턴 `!== 'false'`).
# 배경: injectPerSymbolPriceContext 가 일봉 bars 를 받아 return5d/20d·volume 만 주입하고
#   ma20/ma60/rsi14/atr 는 미계산 → 스코어러 TECHNICAL_TREND/VOLUME_LIQUIDITY 항상 0 →
#   Gate1 score ~49/70 고착(RS 48/48 vs tech 22/48 비대칭: RS 는 featurePack fallback 생존, 기술은 quote 단독).
# ON(기본): 동일 bars(추가 fetch 없음, KIS lookback 35→90역일·호출수 불변 rows만)로 ma/rsi/atr 계산 →
#   candidate.symbolFeatures 주입(기존값 보존). requiredScore=70·게이트 로직 0 변경.
#   executionImpact≠NONE: score 입력 enrich 로 Gate1 통과 분포 상승 가능(의도된 효과).
# 롤백: =false 명시 → 신규 동작 skip(byte-equivalent).
GATE1_TECHNICAL_INDICATOR_INJECTION_ENABLED=true

# P1-FIX — Gate3 outcome forward-return 갱신 cron 스위치 (ADR-0157 정확 비교, default ON).
# 평일 KST 16:35 장 마감 후 PENDING/PARTIAL gate3 seed 의 d1/d3/d5/d10 forward-return 을 갱신
# (학습 증거 전용 — executionImpact=NONE, LIVE 주문 영향 0). 'false' 1줄로 즉시 비활성(롤백).
# GATE3_FORWARD_RETURN_CRON_ENABLED=false

# R6 스마트 복귀 macroState 신선도 등급화 (권장: TTL 300초, soft stale 900초).
# FRESH: TTL 이내 / SOFT_STALE: live 신규 매수 차단 + Shadow recovery watch 허용 / HARD_STALE: R6 release 차단.
MACRO_STATE_TTL_SEC=300
R6_RECOVERY_SOFT_STALE_SEC=900

# ADR-0592 — R6 trigger freshness 를 봉 거래일(KRX) 기준으로 평가 + 오늘 intraday KOSPI 반등 인식 (전부 default OFF).
# 3개 모두 미설정/false = 현 baseline byte-equivalent. 권장 단계 활성: TRADEDATE → QUOTE(shadow 관측) → 검증 → REBOUND_RELEASE.
# (D1) ON 시 어제 폭락 봉이 오늘 'FRESH intraday trigger' 로 오인되는 결함 차단 (age-only freshness 강등).
# R6_TRIGGER_TRADEDATE_FRESHNESS_ENABLED=false
# (D2) ON 시 marketDataRefresh 가 KIS 종합지수(0001) intraday quote fetch → macroState.kospiIntradayReturn 채움 (사이클당 1콜, 실패 시 carry-forward).
# R6_KOSPI_INTRADAY_QUOTE_ENABLED=false
# (D3) ON 시 오늘 intraday 수익률이 recovery 평가(kospiDayReturnOk/strong-rebound)에 live 기여. OFF = shadow/진단 관측만.
# R6_INTRADAY_REBOUND_RELEASE_ENABLED=false
# (D2 Codex 정합 정정) intraday quote 신선도 TTL(초). kospiIntradayFetchedAt 이 now-TTL 보다 오래면 거부 → legacy 폴백.
# carry-forward 된 아침 stale 반등값이 오후 KIS 실패 중 종일 live-eligible 되는 falling-knife 방지. 기본 900초=15분(VKOSPI 패턴 정합).
# R6_KOSPI_INTRADAY_QUOTE_TTL_SEC=900

# ADR-0593 — risk-on fast-upgrade: 폭락 다음날 강반등 시 provisional R3_EARLY 조기 승급 (default OFF byte-equivalent).
# R6 -5% 블랙스완 하락 트리거의 상방 대칭. universe 확장 한정(Gate/Kelly/STRONG_BUY/주문 0줄). breadth 는 D2(R6_KOSPI_INTRADAY_QUOTE_ENABLED)
# 응답 ascn/down_issu_cnt 부산물 — KIS 콜 0 추가. 3중 AND: ① 오늘 강반등(TTL/today-fresh) ② VKOSPI 진정(<=0) ③ breadth 우위(>=ratio).
# ON 시 today-fresh intraday + breadth 동시 충족만 승급. 데이터 부재/stale → 보수적 미승급(불변식 #6: 결손≠signal).
# REGIME_RISK_ON_FAST_UPGRADE_ENABLED=false
# 강반등 임계 T(%). 운영자 확정(counterfactual 튜닝, +3.0~4.0 권장). 기본 3.5.
# REGIME_RISK_ON_FAST_UPGRADE_THRESHOLD_PCT=3.5
# breadth 우위 최소 비율(0~1). 상승종목/(상승+하락). 기본 0.6.
# REGIME_RISK_ON_FAST_UPGRADE_BREADTH_MIN_RATIO=0.6
# ADR-0605 D1 — ④ 미국 야간 보조 AND (정확 비교 === 'true', default OFF). ON 시 SPX 야간
# >= MIN_PCT(가드 [-5,5], 기본 -0.5) 여야 fast-upgrade 발동. SPX 부재 → 보수 미발동(가속 경로 한정).
# REGIME_RISK_ON_FAST_UPGRADE_US_OVERNIGHT_AND_ENABLED=false
# REGIME_RISK_ON_FAST_UPGRADE_US_OVERNIGHT_MIN_PCT=-0.5

# ADR-0630 D1 — 매수/shadow 게이트 정본 raw 단일화 (default OFF byte-identical, shadow 전용).
# ON 시 preflight learningRegime 을 정본 raw(detectedRegime=diagnostics.rawRegime, R6-recovery R5_STABILIZING
# override 미경유)에서 우선 파생 → snapshot.effectiveRegime 이 R5 latch 로 오염돼도 R3_EARLY 회복 → 두 shadow lane 발화.
# 라이브 regime/Kelly/권한 무영향(learningRegime 소비 0, 불변식 #8). 롤백: =false 1줄.
BUY_GATE_CANONICAL_REGIME_ENABLED=false

# ADR-0630 D2 — R6 복구 R5_STABILIZING 무한 latch stuck-exit (default OFF byte-identical, execution-adjacent).
# ON 시 모순 지대(mhs 40~64 + raw 강세 R1/R2/R3_EARLY)에서 raw 강세가 MIN_HEALTHY_TICKS 연속 지속되면
# R5 latch 를 R3_NORMAL 로 강제 종료 → riskOverride/Kelly(×0.50)·display 정상화. 첫 tick 은 R5 유지(초기 falling-knife 보호).
# mhs≥70/≥65 기존 탈출 경로 보존(flag 무관). 롤백: =false 1줄. (D1 과 독립.)
R6_RECOVERY_STUCK_EXIT_ENABLED=false
# stuck-exit 발동 전 요구 raw 강세 연속 tick 임계 (기본 2, 하한 clamp ≥1).
R6_RECOVERY_STUCK_EXIT_MIN_HEALTHY_TICKS=2

# ADR-0628 — 장중 리더 유니버스 신선화. screener.json 이 08:45 1회만 기록되어 09:00 이후
# 신규 리더(예: 삼화콘덴서 +28%)가 발굴 풀(getScreenerCache→intradayScanner)에 부재하던 결함 해소.
# LeadershipBridge 는 prod 에서 이미 활성 — binding 제약은 발굴 입력의 아침 고정이며 본 갱신이 해소.
# 정확 비교(=== 'true'), default OFF = 현 baseline byte-equivalent(아침 1회 스냅샷 그대로).
# INTRADAY_SCREENER_REFRESH_ENABLED=false
# 장중 신선화 최소 주기(분). 기본 12, 하한 5분 clamp(파싱 실패/NaN/5 미만 → 5). KIS quota 보호(ADR-0561 — quota 는
# rate 관리로 해결, Yahoo-first 금지). 신규 fetch 는 기존 preScreenStocks(kisClient 단일통로) 재호출뿐.
# INTRADAY_SCREENER_REFRESH_MIN_INTERVAL_MIN=12

# ADR-0628 D5 — 약세 종목 회전(Intraday Weak Rotation). 신선 리더가 발굴돼도 MOMENTUM cap(soft 40/hard 50)이
# 아침 낙오주로 만석이면 leadershipBridge 가 momentum_full 로 튕긴다(2차 차단). 보호 제외·신선신호 보유 멤버 중
# 신선 screener changeRate(− kospi 당일수익률) 최저 1건을, 신선 리더 강도 > 약세+2.0%p 일 때만 evict 해 자리 양보.
# 약세 신호 = D1 갱신 screener changeRate 의 벤치마크 상대값(신규 fetch 0, KIS quota 추가 0). evict ≠ 학습 정지:
# active scan 풀(watchlist) 멤버십만 제거, counterfactual/shadow ledger 보존(불변식 #2). 보유(shadow/live)·SWING/
# CATALYST·MANUAL·isFocus·bridge grace(10분)·intradayReady 진행 종목은 evict 절대 금지. 정확 비교(=== 'true'),
# default OFF = 현행 cap/cleanup(16:00 EOD + 30분) byte-identical(기존 tryEvictWeakest 복귀).
# INTRADAY_WEAK_ROTATION_ENABLED=false
# 사이클당 evict 상한(churn 방지). 기본 3, 0 이하/NaN → 3. 1 bridgeLeadersToMomentum 호출 = 1 admission 사이클.
# INTRADAY_WEAK_ROTATION_MAX_PER_CYCLE=3

# ADR-0629 — 신선 screener 당일 상위 → 메인 발굴 candidate pool 주입. ADR-0628 이 screener.json 을 당일
# 신선화했으나 메인 스캔 candidate pool(buildCandidatePool)은 그 우물을 안 읽고(loadWatchlist 파생 + 직전 스캔
# carry 자기복제만), getScreenerCache 는 intradayScanner 하나만 읽으며 거기서도 intradayReady 15분 관문에 막혀
# 같은 스캔 미반영. 본 flag ON 시 collectIntradayMoverCandidates() 가 신선 screener 당일 상위(changeRate 내림차순
# 상위 N)를 buildCandidatePool 의 intradayMovers 슬롯에 INTRADAY_MOVER 소스로 주입 → 리더가 15분 관문 우회·평가
# 풀 직접 진입(채점 우회 아님 — Gate0~3+requiredScore70 적용). 신규 KIS fetch 0(캐시 read 만, ADR-0561).
# 정확 비교(=== 'true'), default OFF = candidate pool byte-identical([] 반환). 현 SHADOW_ONLY 라 live NONE.
# INTRADAY_MOVER_CANDIDATE_SOURCE_ENABLED=false
# 당일 상위 주입 상한(풀 폭주·과열 방지). 기본 20, 0 이하/NaN → 20, 상한 50 clamp.
# INTRADAY_MOVER_MAX_INJECT=20

# ADR-0606 — Runner Mode (추세추종 익절 + 슬롯 제외). "러너 = 트레일링 활성 종목 = 슬롯 카운트 제외" 단일 개념.
# SHADOW 전용 · default OFF 시 런타임 byte-equivalent(LIVE 본체 0줄). 정확 비교(=== 'true')만 활성.
# 큰 수익 종목을 분할익절 잔량 전량 트랜치 없이 넓은 트레일링으로 추세 끝까지 추종 + 보유 슬롯에서 제외.
# 승격/스킵/트레일링 폭 판정 SSOT: server/trading/exit/policies/runnerPolicy.ts (순수 함수).
# (게이트 1) 러너 모드 — exitEngine 가 승격 판정·잔량 전량 트랜치 스킵·넓은 트레일링 적용.
# RUNNER_MODE_ENABLED=false
# (게이트 2) 슬롯 제외 — slotAccounting.computeSlotConsumption 가 isRunner 종목을 슬롯 회계에서 제외.
# RUNNER_SLOT_EXEMPTION_ENABLED=false
# 러너 승격 절대 수익률 임계(%). 마지막 LIMIT 트랜치 미도달이라도 이 수익률 초과 시 승격. 가드 [10,40], 기본 18.
# RUNNER_PROMOTE_RETURN_PCT=18
# 러너 트레일링 가산폭(진입 trailPct 에 더함). 가드 [0,0.15], 기본 0.05.
# RUNNER_TRAIL_PCT_BONUS=0.05
# 러너 트레일링 최소폭(바닥). max(진입 trailPct + bonus, floor) 의 floor. 가드 [0.10,0.30], 기본 0.15.
# RUNNER_TRAIL_PCT_FLOOR=0.15

# ADR-0594 — Gate1 reversal momentum credit: risk-on 국면 한정 종목 오늘 단일일 강세(quote.changePercent)를
# PRICE_MOMENTUM 점수에 bounded 양수 보너스로 가산 (default OFF byte-equivalent). ADR-0593(레짐판)의 종목-점수 대칭.
# 게이트 = ADR-0593 RISK_ON_REGIMES(R1_TURBO/R2_BULL/R3_EARLY) 재사용 → breadth/VKOSPI fast-upgrade transitively 상속(이중게이트 회피).
# 양수 가산만 — hard-block/감점/requiredScore 70/Kelly/주문 0줄, maxScore 20 천장 불변(가산 후 clamp). changePercent 기존 trace 필드 → KIS 콜 0.
# OFF / non-risk-on / changePercent 부재 → bonus 0(불변식 #6: 결손≠signal). 과급등(T_cap 초과)은 MAX_BONUS cap(추격은 regime-gate 가 차단).
# GATE1_REVERSAL_MOMENTUM_ENABLED=false
# 가산 시작 임계 T_min(%). noise floor — 미만은 보상 0. 운영자 확정(counterfactual 튜닝). 기본 3.0.
# GATE1_REVERSAL_MOMENTUM_T_MIN_PCT=3.0
# 과열 상한 임계 T_cap(%). 위는 가산 미증가(MAX_BONUS cap). buy-the-top 회피. 기본 12.0.
# GATE1_REVERSAL_MOMENTUM_T_CAP_PCT=12.0
# 보너스 상한 MAX_BONUS(점수). PRICE_MOMENTUM maxScore 20 내 일부. 기본 8.
# GATE1_REVERSAL_MOMENTUM_MAX_BONUS=8

# ADR-0608/0624 D1 — Shadow-only regime-aware Gate1 entry threshold: SHADOW(paper) 진입 게이트에만 regime-aware
# 임계(getEffectiveGateThreshold(regime))를 적용해 [regime, legacy) 구간(R3_EARLY 등) 종목을 paper-fill 시킨다.
# LIVE 진입 임계는 ENV 와 무관하게 항상 getMinGateScore(regime) — byte-equivalent 절대 보존(불변식 #8 분리).
# ADR-0624 D1: default ON(opt-out, always-on 복원). 미설정/임의값=ON. 정확 비교 `!== 'false'` — `=false` 1줄 롤백.
# regime-aware 진입 표본은 entryThresholdMode='REGIME_AWARE_SHADOW' 로 격리(학습 오염 방지). 아래 kill-switch 로 즉시 정지 가능.
# GATE1_REGIME_AWARE_SHADOW_ENTRY_ENABLED=true

# ADR-0619/0624 D1 — Shadow-only Gate3 timing liberalization: SHADOW(paper) 진입의 타이밍 SKIP(quoteSignalType==='SKIP')을
# skipCause ∈ {BAND_MISS, MTAS_WEAK} 한정으로 우회시켜 [40,70)·pre-breakout 종목을 paper-fill 시킨다.
# VIX 보수모드·연속손절홀드·DATA_HOLD·UNKNOWN/미상 사유는 우회 불가(보수 차단 — 무차별 개방 금지).
# LIVE(isShadow=false)·실주문·KIS 0 영향: OFF || isShadow=false → bypass 항상 false → (SKIP && !false)===SKIP byte-identical.
# ADR-0608 Gate1 flag 와 독립(각 `=false` 롤백). 완화 진입 표본은 entryThresholdMode='PREBREAKOUT_SHADOW' 로 격리.
# ADR-0624 D1: default ON(opt-out). 정확 비교 `!== 'false'` — `=false` 1줄 롤백. 아래 kill-switch 로 즉시 정지 가능.
# SHADOW_PREBREAKOUT_ENTRY_ENABLED=true

# ADR-0624 D1 — Shadow liberalization 비상 kill-switch: `=true` 발동 시 위 진입 자유화 flag 2개(Gate1 점수·Gate3 타이밍)를
# 둘 다 OFF 로 강제 → 오늘의 byte-identical 동작으로 1줄 즉시 롤백. shadow 자유화의 유일한 off-switch(미설정=정상 가동).
# (opt-in flag 2개 → 비상 OFF 1개로 knob 축소. live 경로는 isShadow=false 라 ENV/kill 무관 항상 byte-identical.)
# 정확 비교(=== 'true'). default 미설정(=정상 가동). 비상 정지 = `SHADOW_LIBERALIZATION_KILL=true` 1줄.
# SHADOW_LIBERALIZATION_KILL=false

# ADR-0633 — Shadow 자가 검증 후 LIVE-safe ENV 게이트 자동 활성화 master 스위치 (정확 비교 === 'true', default OFF).
# ON 시 엔진이 LIVE-safe(shadow/diagnostic) 게이트에 한해 Shadow 검증 기준(ADR-0631 PromotionReadinessBoard·
#   ADR-0476 Gate1ThresholdEvidenceSummary: matureD5·reviewReady·performanceJustified·consecutive-READY)
#   충족 시 스스로 process.env[envName]='true' set → 기존 reader 자동 픽업(운영자 수동 flip 의존 제거).
# LIVE_SAFE 만 자동활성. LIVE_MONEY(learning→LIVE 가중치·counterfacture gate apply)·절대보존(requiredScore=70·
#   positive-ceiling·regime-aware required flip)은 EXCLUDED — 절대 자동 토글 안 함(불변식 #7/#8).
# OFF(기본) = 엔진 미가동 = byte-identical(어떤 ENV 도 안 건드림). 비가역 변경 0. 롤백 = 본 1줄 `=false`.
# SELF_VALIDATION_AUTO_ACTIVATION_ENABLED=false

# ──────────────────────────────────────────────
# [3] Gemini AI API (퀀트 스크리닝용)
# ──────────────────────────────────────────────

# 서버(Node) 측 Gemini 호출용 키. process.env.GEMINI_API_KEY (또는 API_KEY) 로 읽힘.
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 브라우저(클라이언트) 측 후보 탐색·종목 검색용 키 — 반드시 VITE_ 접두사 필요.
#   DISCOVER 화면의 "Start leader scan"(getMomentumRecommendations AI 선정 단계) 과
#   "시장 검색"(searchStock) 은 브라우저에서 src/services/stock/aiClient.ts:getAI() 를
#   통해 Gemini 를 직접 호출한다. getAI() 의 env 폴백은 import.meta.env.VITE_GEMINI_API_KEY
#   만 읽으므로, 위 GEMINI_API_KEY(접두사 없음)는 Vite 가 브라우저 번들에 노출하지 않아
#   클라이언트 탐색에는 적용되지 않는다. 미설정 시 "API Key is missing" 에러 배너가 뜬다.
#   대안: 앱 내 설정(SettingsModal)에서 키를 입력하면 localStorage(k-stock-settings.userApiKey)
#   에 저장되어 빌드 시점 ENV 없이도 동작한다 (우선순위: localStorage > VITE_GEMINI_API_KEY).
VITE_GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# [4] DART 공시 알림 (선택)
# ──────────────────────────────────────────────

# DART Open API 키 (dart.fss.or.kr → 인증키 신청)
DART_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# KIS_FINANCE_PRIMARY_ENABLED (default TRUE — ADR-0532 Phase 4 승격, kisFinancePrimaryFlag.ts SSOT)
#   default true → KIS L1 재무(ROE/OPM/부채비율/유동비율/EPS/YoY/marginAcceleration)를 Gate2 1차 소스로,
#     PER 은 KIS inquire-price(FHKST01010100)로, OCF/이자보상(현금흐름표)만 DART 잔존에서 머지(mergeKisPrimaryWithDartResidual).
#     KIS=L1 > DART=L2 신뢰등급 상향. KIS 실패 시 DART(기존 경로) fallback.
#   ='false' → DART 1차(ADR-0532 이전 동작)로 즉시 롤백.
#   ⚠️ byte-equivalent 아님 — KIS 재무값≠DART 라 Gate2 FUNDAMENTAL_QUALITY 점수가 이동할 수 있다(gate2 통과 변동=매매 영향).
#      KIS quota 종목당 ~3콜(financial-ratio+income-statement+stability-ratio, 캐시+서킷브레이커 관리, max25 budget). 승격 직후 cache self-heal 재산출 wave.
# KIS_FINANCE_PRIMARY_ENABLED=true

# ──────────────────────────────────────────────
# [4-B] KRX Open API (한국거래소 인증키)
# ──────────────────────────────────────────────
# openapi.krx.co.kr → 마이페이지 → API 인증키 신청 후 승인된 서비스 호출용.
# 미설정 시 서버는 즉시 Yahoo Finance 로 폴백합니다 (기능 중단 없음).
# 승인된 서비스 (2026-04 기준, 사용자 계정):
#   - 유가증권 일별매매정보, 코스닥 일별매매정보
#   - 유가증권 종목기본정보, 코스닥 종목기본정보
#   - KOSPI/KOSDAQ/KRX 시리즈 일별시세, 파생상품지수 시세
# 주의: 일 10,000회 쿼터 제한 — 서버는 15분 캐시 + 서킷브레이커로 쿼터 보호합니다.
#
# 블루프린트 표준 (권장):
#   KRX_API_KEY  — 인증키 (레거시 KRX_OPENAPI_AUTH_KEY 도 계속 인식)
#   KRX_API_BASE — 기본 http://data-dbg.krx.co.kr. 호스트만 적으면 /svc/apis 자동 부착.
# 두 이름을 모두 설정할 경우 레거시(KRX_OPENAPI_*)가 우선합니다.
KRX_API_KEY=
KRX_API_BASE=http://data-dbg.krx.co.kr

# 레거시 호환 — 기존 배포에서 사용 중이면 그대로 두세요. 신규 배포는 위의 KRX_API_* 사용.
KRX_OPENAPI_AUTH_KEY=

# 임시로 KRX 호출을 꺼서 Yahoo 전용으로 되돌리고 싶을 때 true 로 설정.
# (인증키 만료, KRX 점검, 쿼터 소진 대응 스위치)
# 동일 의미의 블루프린트 이름 KRX_API_DISABLED 도 인식됩니다.
KRX_OPENAPI_DISABLED=false

# KIS-first rebuild 운영 모드에서는 자동 scanner/router/FreshData 경로의 KRX HTTP 호출을 막습니다.
# 수동 진단(/krx_diag 성격의 explicit diagnostic)과 after-close/nightly 검증 경로는 코드에서 명시 bypass 할 수 있습니다.
KRX_AUTO_FETCH_DISABLED=false

# 공개(비인증) 엔드포인트 프록시 오버라이드 — data.krx.co.kr 사내 라우팅용 (거의 쓸 일 없음).
# 공개와 인증 엔드포인트는 호스트가 달라 하나의 KRX_API_BASE 로 공유하지 않습니다.
# KRX_PUBLIC_API_BASE=http://data.krx.co.kr

# ──────────────────────────────────────────────
# [5] ECOS 한국은행 경제통계 API
# ──────────────────────────────────────────────

# ECOS Open API 인증키 (ecos.bok.or.kr → 마이페이지 → 인증키 발급)
# 기준금리, 환율, M2 통화량, GDP 성장률, 수출입 데이터 조회에 사용
ECOS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# FRED Open API 인증키 (fred.stlouisfed.org/docs/api/api_key.html → 무료 발급, 32자 영숫자)
# 美 yield curve(T10Y2Y)·SOFR·HY spread·금융스트레스·WTI → MHS 금리/경기/리스크 축에 사용
# 미설정/무효 시 macroIndex 의 fred=false → MHS 부분 degrade. 진단: /macro_source_probe
FRED_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (선택) FRED API base URL override — 기본 https://api.stlouisfed.org.
# 배포지(Railway)에서 api.stlouisfed.org TCP egress 가 차단되면 릴레이 URL 로 교체해 우회한다.
# ⚠️ 아래 <sub> 는 placeholder — 그대로 넣지 말 것! Cloudflare Worker 배포 후 대시보드에 표시되는
#    실제 서브도메인(계정마다 다름)으로 반드시 치환. <,> 가 남아 있으면 URL 파싱 실패(BAD_FRED_API_BASE).
# 예(치환 후): FRED_API_BASE=https://fred-relay.your-actual-subdomain.workers.dev  (infra/fred-relay/)
# 삭제 시 직결 복귀(byte-equivalent). 검증: /macro_source_probe → FRED verdict=OK.
# FRED_API_BASE=https://api.stlouisfed.org
#
# (선택) FRED 요청 타임아웃 ms (기본 15000). 단순 느림 판별·재배포 없이 상향용.
# FRED_REQUEST_TIMEOUT_MS=15000
#
# (선택) FRED 전면 비활성 — true 시 FRED 호출 0(인프라 복구 전 hang 회피용 임시 스위치).
# FRED_API_DISABLED=false

# ──────────────────────────────────────────────
# [6] Telegram Bot 알림 (이메일보다 빠른 실시간 알림, 선택)
# ──────────────────────────────────────────────

# 1. Telegram에서 @BotFather 검색 → /newbot → 이름 설정 → 토큰 발급 (5분 소요)
# 2. 봇과 대화 시작 후 https://api.telegram.org/bot<TOKEN>/getUpdates 에서 chat_id 확인
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# 종목 픽 채널 ID (16:30 일일 픽 리포트 발송 대상 — 선택)
# 공개 채널: "@채널이름", 비공개 채널: "-100xxxxxxxxxx"
# 미설정 시 픽 리포트 전송이 스킵됩니다 (오류 없음)
TELEGRAM_PICK_CHANNEL_ID=-1003960015140

# Multi-channel routing (optional, gradual migration)
TELEGRAM_TRADE_CHANNEL_ID=
TELEGRAM_ANALYSIS_CHANNEL_ID=
TELEGRAM_INFO_CHANNEL_ID=
TELEGRAM_SYSTEM_CHANNEL_ID=
# Optional JSON override per category, e.g.
# CHANNEL_MAP={"TRADE":"-100...","ANALYSIS":"-100...","INFO":"-100...","SYSTEM":"-100..."}
CHANNEL_MAP=
# Category-specific rollout switches (fallback: CHANNEL_ENABLED)
TRADE_CHANNEL_ENABLED=true
ANALYSIS_CHANNEL_ENABLED=true
INFO_CHANNEL_ENABLED=true
SYSTEM_CHANNEL_ENABLED=true

# ── LIVE 모드 SHADOW 격리 (ADR-0607) ──────────────────────────────────────────
# true + getExecutionMode()==='LIVE' 일 때만 SHADOW 신호/메시지를 CH4(SYSTEM/JOURNAL)로
# 격리한다 — CH1(EXECUTION)/CH2(SIGNAL)을 LIVE 체결·신호 전용으로 비운다.
# default(미설정/그 외)=OFF → 현재 SHADOW(OFF/PAPER) 운영은 기존 CH2 라우팅 그대로(영향 0,
# byte-equivalent). 정확 비교(=== 'true')만 활성. LIVE 전환 사전작업 A1.
LIVE_SHADOW_QUIET_ENABLED=false

# ──────────────────────────────────────────────
# [6] 이메일 알림 — ⚠️ 미구현 (2026-06-10 감사)
# ──────────────────────────────────────────────
# EMAIL_FROM / EMAIL_PASS / EMAIL_TO / REPORT_EMAIL 은 코드 어디서도 소비하지 않는다
# (smtp/nodemailer 의존성 0 — 설정해도 아무 일도 일어나지 않음). 알림 채널은 Telegram 단일.
# 이메일 알림이 필요하면 별도 구현 PR 후 본 블록을 복원할 것.

# ──────────────────────────────────────────────
# [6] Railway 배포 설정
# ──────────────────────────────────────────────

# Railway가 자동으로 설정합니다 — 직접 입력 불필요
# (Keep-Alive 자가 핑 URL로 사용됨)
# RAILWAY_STATIC_URL=https://your-app.up.railway.app

# 서버 포트 — Railway가 자동 주입하므로 입력 불필요
# PORT=3001

# 영구 데이터 저장 경로 (Railway Volume 마운트 시 필수)
# Railway Dashboard → Settings → Volumes → /app/data 마운트 후 설정
# 미설정 시 기본값 ./data (배포마다 초기화됨!)
PERSIST_DATA_DIR=/app/data

# Node 환경
NODE_ENV=production

# ──────────────────────────────────────────────
# [6.1] AI 추천 외부 데이터 (ADR-0011, PR-25-A)
# ──────────────────────────────────────────────
# Google Custom Search JSON API — AI 추천 universe 발굴 전용.
# 자동매매 경로(KIS/KRX) 와 분리되어 quota 침범 방지.
# 발급: https://programmablesearchengine.google.com/ (CX) +
#       https://console.cloud.google.com/ (API Key, Custom Search API 활성화)
# 무료 한도: 100 query/day, 초과 시 $5/1000 query
# GOOGLE_SEARCH_API_KEY=AIzaSy...
# GOOGLE_SEARCH_CX=017576662512468239146:omuauf_lfve

# AI 추천 외부 호출 일일 예산 (bucket 별 한도 override).
# 미설정 시 google_search 80 / naver_finance 1000 / krx_master_refresh 5.
# AI_DAILY_CALL_BUDGET=80

# ──────────────────────────────────────────────
# [6.2] Sector Energy Hardening (ADR-0369/0370)
# ──────────────────────────────────────────────
# Sector Energy 매칭 안정성 정책. 기본값은 안전 (default OFF / 30).
#
# SECTOR_ENERGY_INDEX_NAME_FALLBACK (default OFF, ADR-0369/0370 unsafe opt-in)
#   true 시 indexCode 매칭 실패 후 indexName 단독 매칭 fallback 활성. 동일 indexName
#   다른 시장(KOSPI:반도체 vs KOSDAQ:반도체) 의 sub-index 가 잘못 매칭되어 -100~-500%
#   수익률 / 1000%+ 거래량 이상치 발생 위험. 부팅 시 1회 console.warn 출력.
#   회귀 분석 외에는 활성 금지.
# SECTOR_ENERGY_INDEX_NAME_FALLBACK=false
#
# SECTOR_ENERGY_RETURN_SANITY_BOUND_PCT (default 30, ADR-0370)
#   섹터 일일/주간 수익률 sanity 임계 (%). 한국 섹터 일일 ±15%, 주간 ±30% 정상 상한.
#   30 초과 시 데이터 결함(자릿수 격차/액면병합/잘못된 indexName 매칭) 의심으로 skip
#   + 진단 로그. 회귀 발견 시 90 으로 1줄 즉시 롤백 가능.
# SECTOR_ENERGY_RETURN_SANITY_BOUND_PCT=30
#
# SECTOR_ENERGY_SESSION_ISOLATION_ADR0544_DISABLED (default unset = ON, ADR-0544)
#   휴일/비장중 KIS index verify-skip 을 dataQuality=SESSION_NOT_VERIFIABLE 로 표시 분리.
#   true 로 설정 시 어댑터가 세션 신호 전달을 중단 → 기존 MISSING/OFFICIAL_SECTOR_SOURCE_MISSING
#   표시로 byte-equivalent 복귀(게이팅·promotion 은 어차피 불변). 표시 전용, executionImpact=NONE.
# SECTOR_ENERGY_SESSION_ISOLATION_ADR0544_DISABLED=true
#
# SECTOR_ENERGY_LAST_KNOWN_SNAPSHOT_ENABLED (default OFF, ADR-0545)
#   휴일/세션닫힘 시 직전 verified sector snapshot 을 영속(verify 성공 시 write)·표시(LAST_KNOWN_VALID).
#   표시 + shadowEvidence 전용 — last-known 이 있어도 live promotion/sectorBoost/strongBuy 는 절대 활성화 안 함.
#   미설정(OFF) 시 PR-1(ADR-0544) 동작 그대로(write·read 미수행, byte-equivalent). executionImpact=NONE.
# SECTOR_ENERGY_LAST_KNOWN_SNAPSHOT_ENABLED=true
#
# KIS 업종 인덱스 일봉 (FHKUP03500100) 프로덕션 활성화 — SectorCycle 데이터 소스
#   true 시 defaultOfficialIndexRows()가 KIS_SECTOR_ISCD_MAP 12개 업종 ISCD를
#   실제 호출. KRX 의존 없이 Gate2 SECTOR_LEADERSHIP 축을 채울 수 있음.
#   롤백: 이 값을 false 로 변경하면 즉시 basket-derived 경로로 복귀.
# KIS_SECTOR_INDEX_DAILY_ENABLED=true
#
# KIS_SECTOR_INDEX_DAILY_LOOKBACK_DAYS (default 60, 하한 30)
#   fetchKisSectorIndexDaily 기본 조회 윈도(캘린더일). 20d 수익률엔 일봉 21개가 필요한데
#   30일(~21영업일)은 5~6월 휴장 다발 구간에 21행 미만→전 섹터 INSUFFICIENT_SERIES→
#   official 섹터지수 미가용→shadow-only basket 폴백→Gate2 SECTOR_LEADERSHIP 미충전이었다.
#   실측: 45일도 rows=21(마진0)만 반환 → 60일(~25~30영업일)로 마진 확보. 롤백: 30 으로 설정.
# KIS_SECTOR_INDEX_DAILY_LOOKBACK_DAYS=60
# KIS 섹터명 canonical 정규화 (default OFF, ADR-0574)
#   KIS basket fallback 섹터명('2차전지'/'바이오'/'화학'/'건설'/'유통')을 canonical
#   KrxSectorName('이차전지'/'바이오/헬스케어'/'에너지/화학' …)으로 정규화 → Gate2
#   SECTOR_LEADERSHIP 축·섹터 boost 가 sectorEnergyResult.scores[].name 매칭.
#   공식 인덱스 경로(SECTOR_INDEX_MASTER)는 이미 canonical 이라 영향 미미. OFF=byte-identical.
#   Sector 0/25 종단 해소 번들: SECTOR_ENERGY_GATE2_WIRING_ENABLED + KIS_SECTOR_INDEX_DAILY_ENABLED + 본 flag.
# KIS_SECTOR_NAME_CANONICAL_ENABLED=true
#
# SECTOR_INDEX_CYCLE_WIRING_ENABLED (default OFF, ADR-0570, ADR-0423 후속)
#   공식 섹터 index 20d/5d return(fetchKisSectorIndexDaily, realDataKisGet SSOT)을
#   SectorEnergyInput.sectorReturn20d 에 배선 → Gate2 sector cycle "Sector 0/25"
#   (SECTOR_THEME_CYCLE_MISSING) 해소. 섹터당 1콜·refresh 당 1회·6h+ TTL 캐시·후보당 재fetch 0.
#   ★ executionImpact=(b) execution-adjacent — sectorReturn20d 가 hasKisSectorMetrics 를 점화해
#     scoring formula→sector tier(LEADING/LAGGING)→applySectorScoreBoost(+2/-1)→STRONG_BUY 게이팅에
#     영향한다. 활성 전 shadow 검증 필수. OFF(default)=byte-equivalent(미배선·KIS 추가콜 0).
#   ADR-0157 정확 비교(=== 'true'). 롤백=이 값 제거 시 즉시 byte-equivalent 복원.
# SECTOR_INDEX_CYCLE_WIRING_ENABLED=true
#
# SECTOR_LEADERSHIP_CANONICAL_SOURCE_ENABLED (default OFF, ADR-0577 Stage 1)
#   per-candidate Gate2 SECTOR_LEADERSHIP 축의 데이터원을 레거시 basket(KIS_SECTOR_ISCD_MAP
#   2xxx, DIAGNOSTIC_ONLY)에서 canonical verified official(L1, ADR-0570 sectorIndexCycleProvider
#   캐시·신규 KIS콜 0)로 전환. normalizeSectorThemeCycleForGate2 우선순위 raw??canonical(L1)??basket.
#   ★ executionImpact=execution-adjacent — sectorReturn20d→sectorScoreBoost(+2/-1)→STRONG_BUY 게이팅
#     영향. canonical 결손(미verify/off-hours/master 결손)→null=중립→basket graceful fallback.
#   OFF(default)=canonical 미조회·basket 그대로 byte-identical. 활성 전 shadow A/B 필수.
#   공급(SECTOR_INDEX_CYCLE_WIRING_ENABLED)·소비(SECTOR_ENERGY_GATE2_WIRING_ENABLED) flag 와 직교.
#   ADR-0157 정확 비교(=== 'true'). 롤백=이 값 제거 시 즉시 byte-identical 복원.
# SECTOR_LEADERSHIP_CANONICAL_SOURCE_ENABLED=true
# ★★ Gate2 Sector 종단 활성 번들 + 이중 게이트 (2026-06-05 운영 진단 SSOT) ★★
#   "Sector 0/25 → 라벨+returns 완비"까지 필요한 flag 전체와 비자명한 의존 관계:
#   (1) SECTOR_ENERGY_GATE2_WIRING_ENABLED=true  — sectorEnergyResult + sector 라벨을 Gate2 축에 배선
#         (ADR-0568/0571). 이게 OFF면 Sector 0/25(MISSING).
#   (2) KIS_SECTOR_INDEX_DAILY_ENABLED=true       — KIS 업종 일봉(FHKUP03500100) fetch 활성.
#         ★必須: 미설정 시 fetchKisSectorIndexDaily 가 즉시 null 반환(sectorIndex.ts) → (3)을 켜도 returns=null.
#   (3) SECTOR_INDEX_CYCLE_WIRING_ENABLED=true    — 그 일봉으로 sectorReturn20d/5d 계산해 배선(ADR-0570).
#         ⚠ 이중 게이트: (3)만 켜고 (2)를 안 켜면 cycle provider 가 빈 Map → Gate2 sector20d=null(PARTIAL 고착).
#         (3)+(2) 둘 다 ON 이어야 PARTIAL→VERIFIED.
#   (4) KIS_SECTOR_NAME_CANONICAL_ENABLED=true    — basket fallback 경로 섹터명 canonical(ADR-0574).
#         공식 인덱스 경로(SECTOR_INDEX_MASTER)는 이미 canonical 이라 영향 미미.
#   ※ 예외(정상): 이차전지·조선·방산·원자력 은 공식 11-섹터 단일 지수 ISCD 부재(theme-tag 전용) → (2)(3)
#     켜도 sector20d=null 유지. returns 배선되는 11개 공식 섹터 = 반도체·자동차·화학·바이오헬스케어·철강·
#     건설·금융·유통소비재·기계장비·음식료·방송통신.
#   ※ execution-adjacent(sectorReturn20d→sector boost→STRONG_BUY 게이팅) → 활성 후 shadow 검증 의무.
#
# SECTOR_MAP_BOOT_BOOTSTRAP_ENABLED (default ON, Patch-SectorMap-Boot-Bootstrap)
#   부팅 직후 KRX 전종목 섹터맵(data/krx-sector-map.json) 결손/stale self-heal.
#   영속 볼륨(PERSIST_DATA_DIR) 없이 data/ 가 휘발이면 배포마다 섹터맵이 사라져 cron(주간/일일
#   19:00) 전까지 getSectorByCode 가 수동맵(188종목)만 알아 Gate2 Sector 축 커버리지가 급락한다.
#   부트스트랩이 그 배포-직후 갭을 비차단(setTimeout fire-and-forget, 불변식 #1 무차단)으로 메운다.
#   shouldRetrySectorMap()(결손/stale)일 때만 동작 → 최신(볼륨 영속)이면 no-op. 기존 4-tier
#   fallback·runSectorMapUpdate 재사용(신규 데이터 통로 0). 롤백: =false 1줄(부트스트랩 skip, cron 유지).
# SECTOR_MAP_BOOT_BOOTSTRAP_ENABLED=false
#
# R3_GATE1_PASS_ZERO_HARDBLOCK_ENABLED (default false, ADR-0401 트리거 축소 / ADR-0146 1줄 롤백)
#   default false → GATE1_PASS_ZERO streak 가 SHADOW_ONLY pre-scan hard-block 을 트리거하지 않음.
#   Gate1 후보 거부는 *정상 게이트 동작* (약유동성 등) 이지 엔진 고장이 아니므로, 좋은 수급 후보까지
#   SHADOW_ONLY 로 강제하던 false-positive 차단. (streak 관찰 기록 자체는 진단용으로 유지.)
#   ADR-0157 정확 비교 (=== 'true') — true 일 때만 기존 GATE1_PASS_ZERO hard-block 복원.
#   CANDIDATES_ZERO / GATE_PASS_DATA_MISSING (실제 universe 빈/데이터 장애) 방어는 본 게이트 무관 — 항상 유지.
# R3_GATE1_PASS_ZERO_HARDBLOCK_ENABLED=false
#
# (제거됨) R3_SANITY_BLOCK_ENABLED — ADR-0120 R3 sanity 영속 latch 는 이제 *무조건* OBSERVE_ONLY
#   execution guard 로 동작한다 (hard-abort return 경로 제거). live/broker 실주문만 차단하고
#   buyListLoop·Gate 진단은 항상 계속된다. 본 ENV 는 더 이상 동작에 영향이 없으므로 설정 불필요.
#   (운영 환경에 R3_SANITY_BLOCK_ENABLED 가 남아 있어도 무시된다 — 안전하게 삭제 가능.)
#
# GATE1_LIQUIDITY_OPENING_RAMP_ENABLED (default true, ADR-0157 정확 비교 / 1줄 롤백)
#   개장 직후(09:00~09:30 KST)엔 intraday 누적거래량(acml_vol)이 자연 저조 → 상시 유동(20일 평균
#   통과) 종목도 현재거래량 미달로 floor FAIL 되던 오탈락을 방지한다 (SPIKE_ONLY 의 대칭 soft-pass).
#   조건: avg-liquid(20일 평균 통과) + current-low(개장초 저조) + early session → status=OPENING_RAMP(PASS-동등).
#   mid-session 실제 유동성 급감(early session 아님)은 여전히 FAIL — 개장초만 완화한다.
#   ='false' 시 기존 FAIL 동작 byte-equivalent 복원. !== 'false' 일 때만 OPENING_RAMP 활성.
# GATE1_LIQUIDITY_OPENING_RAMP_ENABLED=true
#
# GATE1_FORENSIC_PERSYMBOL_ROW_CARRY_ENABLED (default true, ADR-0514-restore / ADR-0157 정확 비교 / 1줄 롤백)
#   DIAGNOSTIC_ONLY — Gate1 forensic collector(gate1ForensicInputsCollectorAdr0507)가 per-symbol
#   bySymbol 수급 row 를 ENTRY_FILTER / WATCHLIST / SELL_ONLY 후보까지 carry 하게 복원한다. 이전엔
#   PREFLIGHT 후보에만 carry 되어 나머지 후보가 공유 selectedCandidate row 로 fallback → /gate_full
#   semanticAvailable false positive(예: 3/6) 를 만들던 회귀를 차단. score / threshold / execution /
#   live 무영향 (executionImpact='NONE', usableForGate/Live=false). genuine payload 가 있을 때만 carry —
#   없으면 정직하게 unavailable 로 표기(invented data 0).
#   ='false' 시 기존 PREFLIGHT-only 회귀 동작 byte-equivalent 복원. !== 'false' 일 때만 복원 활성.
# GATE1_FORENSIC_PERSYMBOL_ROW_CARRY_ENABLED=true
#
# WATCHLIST_EXCLUDE_SPECIAL_SECURITIES (default true / ADR-0157 정확 비교 / 1줄 롤백)
#   ETF/ETN/ELW/SPAC/리츠/우선주(특수종목) 를 watchlist(관심종목) + 매매 후보에서 제외한다.
#   판정 SSOT: krxStockMasterRepo.isTradableKrxEquity (KRX master 권위) + master miss 시
#   isSpecialSecurityName 종목명 패턴 fallback (보통주 오제외 0 — 미일치 시 KEEP).
#   loadWatchlist 단일 funnel 에서 필터 → 매수 후보·표시 공통 차단. 보유 포지션 청산은
#   shadowTrade/exitEngine 경로라 무영향(매수만 차단, 보유분 매도는 계속 가능).
#   스크리너 유니버스는 이미 무조건 제외(isTradableKrxEquity) 이므로 default ON 과 정합.
#   ='false' 시 기존 동작(특수종목 미제외) byte-equivalent 복원. !== 'false' 일 때만 제외 활성.
# WATCHLIST_EXCLUDE_SPECIAL_SECURITIES=true

# ──────────────────────────────────────────────
# [7] 설정 순서 체크리스트
# ──────────────────────────────────────────────
#
#  □ 1. KIS Developers에서 앱 등록 → APP_KEY / APP_SECRET 발급
#  □ 2. KIS_IS_REAL=false 로 모의투자 먼저 시작
#  □ 3. AUTO_TRADE_ENABLED=false 로 Shadow 모드 검증
#  □ 4. DAILY_LOSS_LIMIT 설정 (5% 권장)
#  □ 5. Railway Variables 탭에 모든 값 입력
#  □ 6. 배포 후 /api/health 응답 확인
#  □ 7. Shadow 모드에서 1~2주 운용 후 실거래 전환 검토
#
# ⚠️  주의사항
#  - .env 파일을 절대 git에 커밋하지 마세요 (.gitignore 확인)
#  - KIS_IS_REAL=true 전환은 충분한 Shadow 검증 후에만
#  - DAILY_LOSS_LIMIT는 본인 리스크 허용 범위로 조정
# ============================================================

# ──────────────────────────────────────────────
# [8] 운영 로그 라우팅 / Noise suppression (default: production-safe)
# ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_SUPPRESS_NOISE=true
LOG_SUPPRESS_PRE_ENTRY_WAIT=true
LOG_SUPPRESS_KIS_WS_DETAIL=true
LOG_SUPPRESS_KIS_MTAS_DETAIL=true
LOG_SUPPRESS_GATE_DIAGNOSTIC=true
LOG_SUPPRESS_KIS_FIRST_DIAGNOSTIC=true
NOISE_SUMMARY_ENABLED=true
NOISE_SUMMARY_INTERVAL_MINUTES=5

# ──────────────────────────────────────────────
# [Data Quality / Enemy Checklist Display Safety]
# materialized=false 데이터는 숫자 신호처럼 표시하지 않습니다.
CARD_HIDE_UNMATERIALIZED_ENEMY_ITEMS=true
TELEGRAM_HIDE_UNMATERIALIZED_ENEMY_ITEMS=true
# ⚠️ [미소비 — 2026-06-10 감사] 아래 플래그는 코드 어디서도 읽지 않는다 (향후 기능 예약 추정).
# PREMORTEM_AI_HYPOTHESIS_EXECUTION_ENABLED=false
DATAQUALITY_BADGE_ENABLED=true

# ──────────────────────────────────────────────
# [ADR-0543] Macro shortSelling KIS L1 Proxy Fallback (KRX OTP outage remediation)
# KRX OTP 구조적 차단으로 shortSelling 신선도가 정체될 때, KIS 공식 daily-short-sale
# 시장-프록시 ETF(069500) 비중을 L1 fallback 으로 사용 + L4(KIS_ESTIMATE/CACHE) 는 R5 8%
# 임계 평가 제외. default OFF → byte-equivalent. =true 로 활성화, =false 1줄 즉시 롤백.
SHORT_SELLING_KIS_PROXY_FALLBACK=false

# ──────────────────────────────────────────────
# [ADR-0547] 기술지표 OHLCV 시계열 1차 출처 KIS 일봉(L1) 승격 (Phase 1 — 정밀 경로 한정)
# ──────────────────────────────────────────────
# 2026-06-06: 코드 default 를 **KIS-first 로 전환**(ENV≠'false' → ON). technicalQuoteRouter 소비자
# (prefetchedContext·stockScreener·buyPipeline·trancheExecutor)가 KIS 일봉(L1)을 기술지표 1차로 쓰고
# Yahoo chart(L3)를 fallback 으로 강등한다(일봉 6h+휴장 TTL 캐시 quota 보호, ADR-0561 KIS-primary).
# 롤백: KIS_OHLCV_PRIMARY_ENABLED=false (Yahoo-first 복귀). KIS 실패/봉수부족 시 자동 Yahoo fallback.
# 미설정=ON(='false' 만 명시 롤백, ADR-0157 정확 비교) — 전 소비처 해석 SSOT: server/clients/kisPrimaryFlag.ts.
KIS_OHLCV_PRIMARY_ENABLED=true

# ──────────────────────────────────────────────
# [ADR-0548] KIS 국내휴장일조회(chk-holiday / CTCA0903R) opnd_yn L1 휴장 권위 동기화
# ──────────────────────────────────────────────
# true 시 maintenanceJobs cron(연 1회 + 월 1회)이 KIS chk-holiday opnd_yn='N' 을
# krxHolidayRepo patch(addedBy:'sync')로 등록 → STATIC ∪ patch 활성 Set 에 병합한다.
# KIS docstring "가급적 1일 1회 호출" → 이미 등록된 연도는 KIS 호출 없이 skip(연 1~2콜).
# KIS 실패 시 STATIC fallback 유지(불변식 #6 — provider 장애 ≠ 약세 신호).
# default OFF(미설정/false) → KIS sync 잡 no-op early return(byte-equivalent, 즉시 1줄 롤백).
# ※ marketClock HOLIDAY_CACHE 분기(평일 휴장 인지)는 본 ENV 와 직교 — STATIC Set 기반 항상 동작.
KIS_HOLIDAY_CALENDAR_ENABLED=false

# ──────────────────────────────────────────────
# [ADR-0567] scan 세션 분류 wall-clock stale 교정 (permissive — false-CLOSED 해소)
# ──────────────────────────────────────────────
# true 시 resolveScanMarketSessionView 가 평일 장중(wall-clock=REGULAR_OPEN + KRX 거래일)인데
# 상류 macro 스냅샷이 stale CLOSED/POST_CLOSE 세션을 주면 REGULAR_OPEN 으로 신뢰 교정한다.
# KRX 거래일 판정은 krxTradingCalendar.isKrxTradingDay(→ krxHolidays SSOT, ADR-0559) 위임 →
# 공휴일(예 2026-06-03 지방선거)은 교정 안 함(CLOSED/POST_CLOSE 유지). 장외 wall-clock(POST_CLOSE/
# CLOSED)·주말·진짜 pre/after-market 은 교정 대상 아님.
# default OFF(미설정/false) → byte-equivalent: 세션 분류 기존 동작 그대로, live 게이팅 불변.
# ON 은 live 게이팅 permissive 방향(장중 false-CLOSED 해소) — 운영자가 shadow 검증 후 활성화 권장.
SCAN_SESSION_WALLCLOCK_CORRECTION_ENABLED=false

# ──────────────────────────────────────────────
# [ADR-0547 §D] 프로덕션 shadow A/B 계측 (Yahoo vs KIS Gate quote 실측 델타 수집)
# ──────────────────────────────────────────────
# true 시 풀스캔 survivor 중 top-N(=30) 후보에 대해 KIS-first Gate quote 를 *병행 평가* 하여
# Yahoo-vs-KIS score/signal/MTAS 델타를 [KIS_SHADOW_AB] 구조화 1라인/심볼로 로깅한다(운영자가
# ~20거래일 노이즈밴드 확정 → flag flip 결정 데이터). 결정 미반영(executionImpact=NONE) — 후보집합/
# 점수/주문에 0 영향(순수 로깅, 불변식 #8 shadow≠live). KIS 조회 실패는 약세 신호로 변환하지 않음
# (불변식 #6 providerIssue≠marketSignal). KIS 호출은 fetchTechnicalQuoteByCode 6h 캐시 재사용(quota bound).
# default OFF(미설정/false) → byte-equivalent: 계측 dormant, KIS 신규호출 0콜, 스캔 동작·로그 불변.
# KIS_OHLCV_PRIMARY_ENABLED 와 별개 flag(상호 무관) — 본 스위치는 계측만, 결정 경로 0줄 변경.
KIS_SHADOW_AB_ENABLED=false

# ──────────────────────────────────────────────
# [ADR-0549] Market Rally Search Lens (추천/관측 전용 read-model)
# ──────────────────────────────────────────────
# true 시 buildMarketRallyLens 가 snapshot/macroState 파생값만으로 시장 급등 lens 를 산출한다.
# 자동매매(signalScanner/gates/buyPipeline)와 물리적으로 분리된 read-model — 주문 생성 0건,
# executionImpact=NONE. PR-1 활성 조건은 1(KOSPI 당일+1.5%)·4(외국인 5일 순매수)·6(20일 추세+당일 반등).
# providerIssue/입력 부재 → enabled=false(불변식 #6, bullish/bearish 변환 금지).
# default OFF(미설정/false) → DISABLED 상수 반환, ScanSummary 가산 필드 undefined(byte-equivalent, 즉시 1줄 롤백).
MARKET_RALLY_LENS_ENABLED=false

# ──────────────────────────────────────────────
# [ADR-0556 / ADR-0557] Unified SourceSnapshot factory 활성화 (per-symbol 일괄 수집 + per-field freshness)
# ──────────────────────────────────────────────
# true 시 signalScanner 가 buyList loop 전에 SymbolDataCollector(collectUnifiedSnapshot)로
# 후보 종목당 1회 KIS 4 엔드포인트를 일괄 수집하고, per-field freshness/providerIssue(DataHealth 매핑)를
# 산출해 진단/관찰(observability) 로 노출한다 — gate 점수·confidence·executionPermission·주문 영향 0.
# default OFF(미설정/false) → 기존 per-gate 개별 fetch 경로 100% 유지, freshness 미산출(byte-equivalent).
# Shadow A/B 승격(ADR-0557 Consumer Contract 검증) 전까지 OFF 유지. =false 1줄 즉시 롤백.
USE_UNIFIED_SOURCE_SNAPSHOT=false

# ──────────────────────────────────────────────
# [ADR-0173~0176] Shadow 학습 Phase 2 잔여 wiring 활성화 4종 (전부 default OFF, === 'true' 정확 비교)
# ──────────────────────────────────────────────
# 권장 활성화 순서: 분석 2종 → resolver → replay queue (각 단계 2~3영업일 관찰).
# 전부 LIVE 매매 경로 무관(executionImpact=NONE) — 롤백은 해당 1줄 제거/false.
#
# 1) Safety Gate 차단 귀인 분석 — 매 거래일 KST 16:40 cron 이 shadow 신호를 read-only 집계해 영속.
SAFETY_GATE_ATTRIBUTION_ENABLED=false
# 2) Shadow vs LIVE 델타 리포트 — 매 거래일 KST 16:45 cron, read-only 분석·영속.
SHADOW_LIVE_DELTA_REPORT_ENABLED=false
# 3) 미래 수익률 확정 resolver — 매 거래일 KST 16:30 cron, 만기 도래 신호의 horizon 수익률 확정.
#    KIS 과거 종가 read-only 조회 발생(일 1회 배치, fetchHistoricalClosePrice KIS-first).
FUTURE_RETURN_RESOLVER_ENABLED=false
# 4) 누락 학습 replay queue — 학습 cron 스킵 시 enqueue, 다음 영업일 KST 09:30 dispatcher 가
#    실제 학습 함수 재실행(단일 job 실패 격리, scheduleGuard catch — 불변식 #2 보존).
MISSED_LEARNING_QUEUE_ENABLED=false

# ──────────────────────────────────────────────
# [ADR-0624] 셰이크아웃 손절-후 N일 outcome 라벨러 (관측 전용, default OFF, === 'true' 정확 비교)
# ──────────────────────────────────────────────
# 실행 청산(HIT_STOP) 포지션의 손절-후 1/3/5/10일 종가를 KIS 일봉(L1, read-only) 으로 추적해
# 청산가 대비 +5% 이상 회복(=셰이크아웃) 여부를 라벨링. shadow-trades.json 무수정·별도 ledger
# 영속. executionImpact=NONE(주문/SourceSnapshot/Gate 본체 0줄). 매 거래일 KST 16:50 cron.
# 롤백은 본 1줄 제거/false.
SHAKEOUT_STOP_FORWARD_LABELER_ENABLED=false

# ──────────────────────────────────────────────
# [ADR-0625] 손실 초기 손절 2-bar 종가확인 확대 (shadow-only, default OFF, === 'true' 정확 비교)
# ──────────────────────────────────────────────
# INITIAL/REGIME 손실 초기 손절(PROFIT_PROTECTION 아님)에 wick 즉시청산 대신 2-bar 종가확인 적용
# (얕은 하락 한정 — returnPct <= -12% 깊은하락은 우회·즉시 손절 유지). LIVE 는 절대 우회 안 함
# (getTradingMode()!=='LIVE' 게이트 — LIVE byte-equivalent 보증, 불변식 #8). SHADOW 만 close-confirm.
# 롤백은 본 1줄 제거/false → LIVE·SHADOW 모두 wick 즉시손절 복원.
SHAKEOUT_INITIAL_LOSS_TWOBAR_SHADOW_ENABLED=false

# ──────────────────────────────────────────────
# [2026-06-10 감사] 코드 소비 중이나 미문서화였던 운영 스위치 4종 (전부 선택)
# ──────────────────────────────────────────────
# AI provider 선택 — 미설정 시 'gemini'. 허용값: gemini | openai | groq | self-hosted
# (server/ai/aiProvider.ts SSOT).
# AI_PROVIDER=gemini

# KIS-first 재구축 운영 모드 — true 시 KRX auto-fetch 억제(ADR-0487 fresh supply layer) +
# legacy 진단 lane 로그 활성. default OFF, === 'true' 정확 비교, 1줄 롤백.
# KIS_FIRST_REBUILD_MODE=false

# counterfactual 학습 임계의 Gate 실적용 게이트(ADR-0157 정확 비교, default OFF) —
# OFF 면 학습 임계는 관측만 하고 Gate 판정에 미적용 (server/learning/gateLearnedThresholdApply.ts).
# 철자 COUNTERFACTURE 는 코드 정합 유지 (rename 은 behavior change·별도 PR).
# COUNTERFACTURE_GATE_APPLY_ENABLED=false

# ADR-0632 counterfactual outcome board 표본 위생 캡처 (ADR-0157 정확 비교, default OFF) —
# ON 시 ADR-0430 counterfactual row 에 sourceSnapshotId/candidateSetId/entryPriceHint(KIS L1) 를
# stamp → board exclusion gate(MISSING_SOURCE_SNAPSHOT_ID/CANDIDATE_SET_ID/REFERENCE_PRICE) 해소,
# 학습 표본 확대. 학습 전용 — live 매매·실행 분기·storage 키 0 변경. OFF 면 byte-identical(1줄 롤백).
# COUNTERFACTUAL_SNAPSHOT_CAPTURE_ENABLED=false

# ADR-0411 provider degraded 처리 비활성 킬스위치 (긴급 운영용, default OFF) —
# true 시 27조건 registry 의 provider degraded 분기를 끈다 (server/quant/conditions/registry.ts).
# ADR_0411_PROVIDER_DEGRADED_DISABLED=false

# [거버넌스 — check_pending_wiring.js 정적 검사 전용, 런타임 매매 무관]
# PENDING_WIRING 백로그 "사용자 결정" / "SL 이후 추천" BLOCKED 항목이 N일 무변동 시
# 재검토 WARN(EXIT=0, informational)으로 재노출 — 방치돼 맥락 휘발된 부채의 주기적 재결정 강제.
# reason 에 "재노출 YYYY-MM-DD" 갱신 시 clock 리셋(self-clearing).
# USER_DECISION_REVIEW_DAYS=30           # 재검토 임계 일수 (1~365, default 30)
# USER_DECISION_REVIEW_DISABLED=false    # true 시 I 검사 비활성
