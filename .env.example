# ============================================================
#  QuantMaster Pro — Railway 환경변수 완전 설정 가이드
#  이 파일을 .env로 복사 후 실제 값을 입력하세요.
#  Railway Dashboard → Variables 탭에서 동일하게 설정하세요.
# ============================================================

# ──────────────────────────────────────────────
# [1] KIS (한국투자증권) API 설정
# ──────────────────────────────────────────────

# KIS 앱키 / 앱시크릿 (KIS Developers → 앱 등록 후 발급)
# 처음에는 모의투자(VTS) 계좌 앱키를 사용하세요
KIS_APP_KEY=PSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIS_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 계좌번호 — 앞 8자리만 입력 (예: 50123456)
KIS_ACCOUNT_NO=50123456

# 계좌 상품코드 — 일반적으로 01
KIS_ACCOUNT_PROD=01

# true = 실거래, false = 모의투자(VTS)
# ⚠️ 처음에는 반드시 false로 시작하세요!
KIS_IS_REAL=false

# ──────────────────────────────────────────────
# [1-B] 실계좌 데이터 전용 키 (하이브리드 구조, 선택)
# ──────────────────────────────────────────────
# 모의계좌(VTS)로 주문을 집행하면서, 실계좌 키로 시장 데이터를 조회합니다.
# 거래량 순위, 상승률 순위 등 실계좌에서만 제공하는 데이터에 사용됩니다.
# ※ 주문은 절대 실행하지 않으며, 데이터 조회(GET)만 수행합니다.
# ※ 미설정 시 모의계좌 키로 자동 폴백합니다.
KIS_REAL_DATA_APP_KEY=
KIS_REAL_DATA_APP_SECRET=

# ──────────────────────────────────────────────
# [2] 자동매매 제어 설정
# ──────────────────────────────────────────────

# 서버사이드 자동매매 활성화 여부
# Shadow 모드로 충분히 검증한 후 true로 변경하세요
AUTO_TRADE_ENABLED=false

# 클라이언트-서버 중복 주문 방지 플래그
# AUTO_TRADE_ENABLED=true로 설정할 때 이 값도 true로 맞추세요.
# true이면 클라이언트(브라우저)에서의 실주문이 차단되고
# 서버 autoTradeEngine만 주문을 집행합니다.
VITE_AUTO_TRADE_ENABLED=false

# ──────────────────────────────────────────────
# [2-A] 실행 모드 & 모의(VTS) 매매 (ADR-0553)
# ──────────────────────────────────────────────
# 실행 방향: SHADOW(가상, 기본) / LIVE(실제 주문 집행) / VTS(=PAPER 매핑). 미설정 시 SHADOW.
# "주문을 낼지(아래 mode)" 와 "어느 계좌인지(KIS_IS_REAL)" 는 직교 2축:
#   · 모의(VTS) 매매 = AUTO_TRADE_MODE=LIVE + KIS_IS_REAL=false + VTS_PAPER_TRADING_ENABLED=true
#   · 실계좌  매매   = AUTO_TRADE_MODE=LIVE + KIS_IS_REAL=true  + KIS_REAL_MONEY_ACK=true
AUTO_TRADE_MODE=SHADOW

# [ADR-0553] 모의(VTS) 매매 대칭 활성화. default 미설정(false).
# true + (AUTO_TRADE_MODE=LIVE & KIS_IS_REAL=false) 일 때만 모의계좌로 매수·매도가 대칭 집행됩니다.
# 미설정 시 LIVE+모의 조합은 기동 거부 — 매수만 나가고 매도가 차단되는 비대칭을 막습니다.
# ⚠️ 실제 돈 위험 없음 — KIS_IS_REAL=false 이므로 모의계좌(VTS)에만 주문이 나갑니다.
VTS_PAPER_TRADING_ENABLED=false

# [ADR-0553] 실계좌(실제 돈) 매매 명시 승인. default 미설정(false).
# AUTO_TRADE_MODE=LIVE + KIS_IS_REAL=true 일 때 이 값이 true 가 아니면 서버 기동을 거부합니다.
# 🔴 실수로 실거래가 켜지는 것을 막는 하드가드 — 실거래 의도가 확실할 때만 true.
KIS_REAL_MONEY_ACK=false

# 서버 자동매매 투자 총자산 (원) — 미설정 시 1억원 기본값
# 모의계좌 초기자금에 맞춰 설정하세요 (예: 3천만원 = 30000000)
AUTO_TRADE_ASSETS=30000000

# 1회 최대 포지션 크기 (총 자산 대비 %) — 권장: 5~10
MAX_POSITION_PCT=10

# 일일 손실 한도 (총 자산 대비 %) — 초과 시 긴급 자동 정지
DAILY_LOSS_LIMIT=5

# PR-22 / ADR-0008 — Kelly 시간감쇠 wiring 스위치.
# false 로 두면 accountRiskBudget 가 timeDecayInput 을 받아도 staticKelly 로 단락. 긴급 롤백용.
# KELLY_TIME_DECAY_ENABLED=true

# PR-22 / ADR-0007 — 학습 모듈 하이브리드 suggest 알림 스위치.
# false 로 두면 counterfactual/ledger/kellySurface/regimeCoverage suggest 알림이 전부 차단됨.
# LEARNING_SUGGEST_ENABLED=true

# ADR-0546 Phase 1 — Gate1 required score 레짐 인식 스위치 (default OFF, 동작 보존).
# false(기본): 모든 레짐에서 레거시 70 반환 → live/diagnostic 결과 0 변화.
# true: resolveGate1RequiredScore 가 getEffectiveGateThreshold(regime)×10 반환 (R3_EARLY→40~60).
# Phase 2(운영자 승인 + forward-outcome 검증) 전까지 false 유지. 'false' 1줄로 즉시 롤백.
# GATE1_REGIME_AWARE_REQUIRED=false

# P1-FIX — Gate3 outcome forward-return 갱신 cron 스위치 (ADR-0157 정확 비교, default ON).
# 평일 KST 16:35 장 마감 후 PENDING/PARTIAL gate3 seed 의 d1/d3/d5/d10 forward-return 을 갱신
# (학습 증거 전용 — executionImpact=NONE, LIVE 주문 영향 0). 'false' 1줄로 즉시 비활성(롤백).
# GATE3_FORWARD_RETURN_CRON_ENABLED=false

# R6 스마트 복귀 macroState 신선도 등급화 (권장: TTL 300초, soft stale 900초).
# FRESH: TTL 이내 / SOFT_STALE: live 신규 매수 차단 + Shadow recovery watch 허용 / HARD_STALE: R6 release 차단.
MACRO_STATE_TTL_SEC=300
R6_RECOVERY_SOFT_STALE_SEC=900

# ──────────────────────────────────────────────
# [3] Gemini AI API (퀀트 스크리닝용)
# ──────────────────────────────────────────────

# 서버(Node) 측 Gemini 호출용 키. process.env.GEMINI_API_KEY (또는 API_KEY) 로 읽힘.
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 브라우저(클라이언트) 측 후보 탐색·종목 검색용 키 — 반드시 VITE_ 접두사 필요.
#   DISCOVER 화면의 "Start leader scan"(getMomentumRecommendations AI 선정 단계) 과
#   "시장 검색"(searchStock) 은 브라우저에서 src/services/stock/aiClient.ts:getAI() 를
#   통해 Gemini 를 직접 호출한다. getAI() 의 env 폴백은 import.meta.env.VITE_GEMINI_API_KEY
#   만 읽으므로, 위 GEMINI_API_KEY(접두사 없음)는 Vite 가 브라우저 번들에 노출하지 않아
#   클라이언트 탐색에는 적용되지 않는다. 미설정 시 "API Key is missing" 에러 배너가 뜬다.
#   대안: 앱 내 설정(SettingsModal)에서 키를 입력하면 localStorage(k-stock-settings.userApiKey)
#   에 저장되어 빌드 시점 ENV 없이도 동작한다 (우선순위: localStorage > VITE_GEMINI_API_KEY).
VITE_GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# [4] DART 공시 알림 (선택)
# ──────────────────────────────────────────────

# DART Open API 키 (dart.fss.or.kr → 인증키 신청)
DART_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# KIS_FINANCE_PRIMARY_ENABLED (default false, ADR-0532 Phase 2 — PER 복구)
#   default false → 기존 동작 byte-equivalent (Gate2 PER read 경로는 DART-coupled refresh 의존, cache-miss 시 source=NONE).
#   ='true' → gate2 read 경로(getGate2DartFinancialsForEvaluation) cache-miss 시 KIS inquire-price(FHKST01010100)에서
#     PER 를 DART 성공 여부와 독립적으로 가져와 cache projection.valuation.per 에 주입 (현재 perStatus=UNAVAILABLE 복구).
#   diagnostic/Gate2 입력 한정, executionImpact=NONE. PER 'LOW' priority + cache-first. (ADR-0532 KIS-first 마이그레이션의 1차 단계)
# KIS_FINANCE_PRIMARY_ENABLED=false

# ──────────────────────────────────────────────
# [4-B] KRX Open API (한국거래소 인증키)
# ──────────────────────────────────────────────
# openapi.krx.co.kr → 마이페이지 → API 인증키 신청 후 승인된 서비스 호출용.
# 미설정 시 서버는 즉시 Yahoo Finance 로 폴백합니다 (기능 중단 없음).
# 승인된 서비스 (2026-04 기준, 사용자 계정):
#   - 유가증권 일별매매정보, 코스닥 일별매매정보
#   - 유가증권 종목기본정보, 코스닥 종목기본정보
#   - KOSPI/KOSDAQ/KRX 시리즈 일별시세, 파생상품지수 시세
# 주의: 일 10,000회 쿼터 제한 — 서버는 15분 캐시 + 서킷브레이커로 쿼터 보호합니다.
#
# 블루프린트 표준 (권장):
#   KRX_API_KEY  — 인증키 (레거시 KRX_OPENAPI_AUTH_KEY 도 계속 인식)
#   KRX_API_BASE — 기본 http://data-dbg.krx.co.kr. 호스트만 적으면 /svc/apis 자동 부착.
# 두 이름을 모두 설정할 경우 레거시(KRX_OPENAPI_*)가 우선합니다.
KRX_API_KEY=
KRX_API_BASE=http://data-dbg.krx.co.kr

# 레거시 호환 — 기존 배포에서 사용 중이면 그대로 두세요. 신규 배포는 위의 KRX_API_* 사용.
KRX_OPENAPI_AUTH_KEY=

# 임시로 KRX 호출을 꺼서 Yahoo 전용으로 되돌리고 싶을 때 true 로 설정.
# (인증키 만료, KRX 점검, 쿼터 소진 대응 스위치)
# 동일 의미의 블루프린트 이름 KRX_API_DISABLED 도 인식됩니다.
KRX_OPENAPI_DISABLED=false

# KIS-first rebuild 운영 모드에서는 자동 scanner/router/FreshData 경로의 KRX HTTP 호출을 막습니다.
# 수동 진단(/krx_diag 성격의 explicit diagnostic)과 after-close/nightly 검증 경로는 코드에서 명시 bypass 할 수 있습니다.
KRX_AUTO_FETCH_DISABLED=false

# 공개(비인증) 엔드포인트 프록시 오버라이드 — data.krx.co.kr 사내 라우팅용 (거의 쓸 일 없음).
# 공개와 인증 엔드포인트는 호스트가 달라 하나의 KRX_API_BASE 로 공유하지 않습니다.
# KRX_PUBLIC_API_BASE=http://data.krx.co.kr

# ──────────────────────────────────────────────
# [5] ECOS 한국은행 경제통계 API
# ──────────────────────────────────────────────

# ECOS Open API 인증키 (ecos.bok.or.kr → 마이페이지 → 인증키 발급)
# 기준금리, 환율, M2 통화량, GDP 성장률, 수출입 데이터 조회에 사용
ECOS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# [6] Telegram Bot 알림 (이메일보다 빠른 실시간 알림, 선택)
# ──────────────────────────────────────────────

# 1. Telegram에서 @BotFather 검색 → /newbot → 이름 설정 → 토큰 발급 (5분 소요)
# 2. 봇과 대화 시작 후 https://api.telegram.org/bot<TOKEN>/getUpdates 에서 chat_id 확인
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# 종목 픽 채널 ID (16:30 일일 픽 리포트 발송 대상 — 선택)
# 공개 채널: "@채널이름", 비공개 채널: "-100xxxxxxxxxx"
# 미설정 시 픽 리포트 전송이 스킵됩니다 (오류 없음)
TELEGRAM_PICK_CHANNEL_ID=-1003960015140

# Multi-channel routing (optional, gradual migration)
TELEGRAM_TRADE_CHANNEL_ID=
TELEGRAM_ANALYSIS_CHANNEL_ID=
TELEGRAM_INFO_CHANNEL_ID=
TELEGRAM_SYSTEM_CHANNEL_ID=
# Optional JSON override per category, e.g.
# CHANNEL_MAP={"TRADE":"-100...","ANALYSIS":"-100...","INFO":"-100...","SYSTEM":"-100..."}
CHANNEL_MAP=
# Category-specific rollout switches (fallback: CHANNEL_ENABLED)
TRADE_CHANNEL_ENABLED=true
ANALYSIS_CHANNEL_ENABLED=true
INFO_CHANNEL_ENABLED=true
SYSTEM_CHANNEL_ENABLED=true

# ──────────────────────────────────────────────
# [6] 이메일 알림 (선택)
# ──────────────────────────────────────────────

# Gmail 또는 SMTP 발신 계정
EMAIL_FROM=your-email@gmail.com

# Gmail 앱 비밀번호 (2단계 인증 후 앱 비밀번호 생성)
# Google 계정 → 보안 → 앱 비밀번호
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# 알림 수신 이메일 (발신과 동일해도 됨)
EMAIL_TO=your-email@gmail.com

# 일일 자동매매 리포트 수신 이메일 (미설정 시 EMAIL_USER로 발송)
REPORT_EMAIL=your-email@gmail.com

# ──────────────────────────────────────────────
# [6] Railway 배포 설정
# ──────────────────────────────────────────────

# Railway가 자동으로 설정합니다 — 직접 입력 불필요
# (Keep-Alive 자가 핑 URL로 사용됨)
# RAILWAY_STATIC_URL=https://your-app.up.railway.app

# 서버 포트 — Railway가 자동 주입하므로 입력 불필요
# PORT=3001

# 영구 데이터 저장 경로 (Railway Volume 마운트 시 필수)
# Railway Dashboard → Settings → Volumes → /app/data 마운트 후 설정
# 미설정 시 기본값 ./data (배포마다 초기화됨!)
PERSIST_DATA_DIR=/app/data

# Node 환경
NODE_ENV=production

# ──────────────────────────────────────────────
# [6.1] AI 추천 외부 데이터 (ADR-0011, PR-25-A)
# ──────────────────────────────────────────────
# Google Custom Search JSON API — AI 추천 universe 발굴 전용.
# 자동매매 경로(KIS/KRX) 와 분리되어 quota 침범 방지.
# 발급: https://programmablesearchengine.google.com/ (CX) +
#       https://console.cloud.google.com/ (API Key, Custom Search API 활성화)
# 무료 한도: 100 query/day, 초과 시 $5/1000 query
# GOOGLE_SEARCH_API_KEY=AIzaSy...
# GOOGLE_SEARCH_CX=017576662512468239146:omuauf_lfve

# AI 추천 외부 호출 일일 예산 (bucket 별 한도 override).
# 미설정 시 google_search 80 / naver_finance 1000 / krx_master_refresh 5.
# AI_DAILY_CALL_BUDGET=80

# ──────────────────────────────────────────────
# [6.2] Sector Energy Hardening (ADR-0369/0370)
# ──────────────────────────────────────────────
# Sector Energy 매칭 안정성 정책. 기본값은 안전 (default OFF / 30).
#
# SECTOR_ENERGY_INDEX_NAME_FALLBACK (default OFF, ADR-0369/0370 unsafe opt-in)
#   true 시 indexCode 매칭 실패 후 indexName 단독 매칭 fallback 활성. 동일 indexName
#   다른 시장(KOSPI:반도체 vs KOSDAQ:반도체) 의 sub-index 가 잘못 매칭되어 -100~-500%
#   수익률 / 1000%+ 거래량 이상치 발생 위험. 부팅 시 1회 console.warn 출력.
#   회귀 분석 외에는 활성 금지.
# SECTOR_ENERGY_INDEX_NAME_FALLBACK=false
#
# SECTOR_ENERGY_RETURN_SANITY_BOUND_PCT (default 30, ADR-0370)
#   섹터 일일/주간 수익률 sanity 임계 (%). 한국 섹터 일일 ±15%, 주간 ±30% 정상 상한.
#   30 초과 시 데이터 결함(자릿수 격차/액면병합/잘못된 indexName 매칭) 의심으로 skip
#   + 진단 로그. 회귀 발견 시 90 으로 1줄 즉시 롤백 가능.
# SECTOR_ENERGY_RETURN_SANITY_BOUND_PCT=30
#
# SECTOR_ENERGY_SESSION_ISOLATION_ADR0544_DISABLED (default unset = ON, ADR-0544)
#   휴일/비장중 KIS index verify-skip 을 dataQuality=SESSION_NOT_VERIFIABLE 로 표시 분리.
#   true 로 설정 시 어댑터가 세션 신호 전달을 중단 → 기존 MISSING/OFFICIAL_SECTOR_SOURCE_MISSING
#   표시로 byte-equivalent 복귀(게이팅·promotion 은 어차피 불변). 표시 전용, executionImpact=NONE.
# SECTOR_ENERGY_SESSION_ISOLATION_ADR0544_DISABLED=true
#
# SECTOR_ENERGY_LAST_KNOWN_SNAPSHOT_ENABLED (default OFF, ADR-0545)
#   휴일/세션닫힘 시 직전 verified sector snapshot 을 영속(verify 성공 시 write)·표시(LAST_KNOWN_VALID).
#   표시 + shadowEvidence 전용 — last-known 이 있어도 live promotion/sectorBoost/strongBuy 는 절대 활성화 안 함.
#   미설정(OFF) 시 PR-1(ADR-0544) 동작 그대로(write·read 미수행, byte-equivalent). executionImpact=NONE.
# SECTOR_ENERGY_LAST_KNOWN_SNAPSHOT_ENABLED=true
#
# KIS 업종 인덱스 일봉 (FHKUP03500100) 프로덕션 활성화 — SectorCycle 데이터 소스
#   true 시 defaultOfficialIndexRows()가 KIS_SECTOR_ISCD_MAP 12개 업종 ISCD를
#   실제 호출. KRX 의존 없이 Gate2 SECTOR_LEADERSHIP 축을 채울 수 있음.
#   롤백: 이 값을 false 로 변경하면 즉시 basket-derived 경로로 복귀.
# KIS_SECTOR_INDEX_DAILY_ENABLED=true
#
# R3_GATE1_PASS_ZERO_HARDBLOCK_ENABLED (default false, ADR-0401 트리거 축소 / ADR-0146 1줄 롤백)
#   default false → GATE1_PASS_ZERO streak 가 SHADOW_ONLY pre-scan hard-block 을 트리거하지 않음.
#   Gate1 후보 거부는 *정상 게이트 동작* (약유동성 등) 이지 엔진 고장이 아니므로, 좋은 수급 후보까지
#   SHADOW_ONLY 로 강제하던 false-positive 차단. (streak 관찰 기록 자체는 진단용으로 유지.)
#   ADR-0157 정확 비교 (=== 'true') — true 일 때만 기존 GATE1_PASS_ZERO hard-block 복원.
#   CANDIDATES_ZERO / GATE_PASS_DATA_MISSING (실제 universe 빈/데이터 장애) 방어는 본 게이트 무관 — 항상 유지.
# R3_GATE1_PASS_ZERO_HARDBLOCK_ENABLED=false
#
# (제거됨) R3_SANITY_BLOCK_ENABLED — ADR-0120 R3 sanity 영속 latch 는 이제 *무조건* OBSERVE_ONLY
#   execution guard 로 동작한다 (hard-abort return 경로 제거). live/broker 실주문만 차단하고
#   buyListLoop·Gate 진단은 항상 계속된다. 본 ENV 는 더 이상 동작에 영향이 없으므로 설정 불필요.
#   (운영 환경에 R3_SANITY_BLOCK_ENABLED 가 남아 있어도 무시된다 — 안전하게 삭제 가능.)
#
# GATE1_LIQUIDITY_OPENING_RAMP_ENABLED (default true, ADR-0157 정확 비교 / 1줄 롤백)
#   개장 직후(09:00~09:30 KST)엔 intraday 누적거래량(acml_vol)이 자연 저조 → 상시 유동(20일 평균
#   통과) 종목도 현재거래량 미달로 floor FAIL 되던 오탈락을 방지한다 (SPIKE_ONLY 의 대칭 soft-pass).
#   조건: avg-liquid(20일 평균 통과) + current-low(개장초 저조) + early session → status=OPENING_RAMP(PASS-동등).
#   mid-session 실제 유동성 급감(early session 아님)은 여전히 FAIL — 개장초만 완화한다.
#   ='false' 시 기존 FAIL 동작 byte-equivalent 복원. !== 'false' 일 때만 OPENING_RAMP 활성.
# GATE1_LIQUIDITY_OPENING_RAMP_ENABLED=true
#
# GATE1_FORENSIC_PERSYMBOL_ROW_CARRY_ENABLED (default true, ADR-0514-restore / ADR-0157 정확 비교 / 1줄 롤백)
#   DIAGNOSTIC_ONLY — Gate1 forensic collector(gate1ForensicInputsCollectorAdr0507)가 per-symbol
#   bySymbol 수급 row 를 ENTRY_FILTER / WATCHLIST / SELL_ONLY 후보까지 carry 하게 복원한다. 이전엔
#   PREFLIGHT 후보에만 carry 되어 나머지 후보가 공유 selectedCandidate row 로 fallback → /gate_full
#   semanticAvailable false positive(예: 3/6) 를 만들던 회귀를 차단. score / threshold / execution /
#   live 무영향 (executionImpact='NONE', usableForGate/Live=false). genuine payload 가 있을 때만 carry —
#   없으면 정직하게 unavailable 로 표기(invented data 0).
#   ='false' 시 기존 PREFLIGHT-only 회귀 동작 byte-equivalent 복원. !== 'false' 일 때만 복원 활성.
# GATE1_FORENSIC_PERSYMBOL_ROW_CARRY_ENABLED=true
#
# WATCHLIST_EXCLUDE_SPECIAL_SECURITIES (default true / ADR-0157 정확 비교 / 1줄 롤백)
#   ETF/ETN/ELW/SPAC/리츠/우선주(특수종목) 를 watchlist(관심종목) + 매매 후보에서 제외한다.
#   판정 SSOT: krxStockMasterRepo.isTradableKrxEquity (KRX master 권위) + master miss 시
#   isSpecialSecurityName 종목명 패턴 fallback (보통주 오제외 0 — 미일치 시 KEEP).
#   loadWatchlist 단일 funnel 에서 필터 → 매수 후보·표시 공통 차단. 보유 포지션 청산은
#   shadowTrade/exitEngine 경로라 무영향(매수만 차단, 보유분 매도는 계속 가능).
#   스크리너 유니버스는 이미 무조건 제외(isTradableKrxEquity) 이므로 default ON 과 정합.
#   ='false' 시 기존 동작(특수종목 미제외) byte-equivalent 복원. !== 'false' 일 때만 제외 활성.
# WATCHLIST_EXCLUDE_SPECIAL_SECURITIES=true

# ──────────────────────────────────────────────
# [7] 설정 순서 체크리스트
# ──────────────────────────────────────────────
#
#  □ 1. KIS Developers에서 앱 등록 → APP_KEY / APP_SECRET 발급
#  □ 2. KIS_IS_REAL=false 로 모의투자 먼저 시작
#  □ 3. AUTO_TRADE_ENABLED=false 로 Shadow 모드 검증
#  □ 4. DAILY_LOSS_LIMIT 설정 (5% 권장)
#  □ 5. Railway Variables 탭에 모든 값 입력
#  □ 6. 배포 후 /api/health 응답 확인
#  □ 7. Shadow 모드에서 1~2주 운용 후 실거래 전환 검토
#
# ⚠️  주의사항
#  - .env 파일을 절대 git에 커밋하지 마세요 (.gitignore 확인)
#  - KIS_IS_REAL=true 전환은 충분한 Shadow 검증 후에만
#  - DAILY_LOSS_LIMIT는 본인 리스크 허용 범위로 조정
# ============================================================

# ──────────────────────────────────────────────
# [8] 운영 로그 라우팅 / Noise suppression (default: production-safe)
# ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_SUPPRESS_NOISE=true
LOG_SUPPRESS_PRE_ENTRY_WAIT=true
LOG_SUPPRESS_KIS_WS_DETAIL=true
LOG_SUPPRESS_KIS_MTAS_DETAIL=true
LOG_SUPPRESS_GATE_DIAGNOSTIC=true
LOG_SUPPRESS_KIS_FIRST_DIAGNOSTIC=true
NOISE_SUMMARY_ENABLED=true
NOISE_SUMMARY_INTERVAL_MINUTES=5

# ──────────────────────────────────────────────
# [Data Quality / Enemy Checklist Display Safety]
# materialized=false 데이터는 숫자 신호처럼 표시하지 않습니다.
CARD_HIDE_UNMATERIALIZED_ENEMY_ITEMS=true
TELEGRAM_HIDE_UNMATERIALIZED_ENEMY_ITEMS=true
PREMORTEM_AI_HYPOTHESIS_EXECUTION_ENABLED=false
DATAQUALITY_BADGE_ENABLED=true

# ──────────────────────────────────────────────
# [ADR-0543] Macro shortSelling KIS L1 Proxy Fallback (KRX OTP outage remediation)
# KRX OTP 구조적 차단으로 shortSelling 신선도가 정체될 때, KIS 공식 daily-short-sale
# 시장-프록시 ETF(069500) 비중을 L1 fallback 으로 사용 + L4(KIS_ESTIMATE/CACHE) 는 R5 8%
# 임계 평가 제외. default OFF → byte-equivalent. =true 로 활성화, =false 1줄 즉시 롤백.
SHORT_SELLING_KIS_PROXY_FALLBACK=false

# ──────────────────────────────────────────────
# [ADR-0547] 기술지표 OHLCV 시계열 1차 출처 KIS 일봉(L1) 승격 (Phase 1 — 정밀 경로 한정)
# ──────────────────────────────────────────────
# true 시 정밀/AI 경로(prefetchedContext)가 KIS 일봉을 기술지표 1차 출처로 사용하고
# Yahoo chart 를 fallback 으로 강등한다 (일봉 6h + 휴장 인지 TTL 캐시로 quota 보호).
# default OFF(미설정/false) → 기존 Yahoo-first 동작 byte-equivalent 보존(회귀 0, 즉시 롤백).
# 풀스캔(stockScreener/universeScanner)은 Phase 2 별도 — 본 스위치 영향 없음(Yahoo 우선 유지).
KIS_OHLCV_PRIMARY_ENABLED=false

# ──────────────────────────────────────────────
# [ADR-0548] KIS 국내휴장일조회(chk-holiday / CTCA0903R) opnd_yn L1 휴장 권위 동기화
# ──────────────────────────────────────────────
# true 시 maintenanceJobs cron(연 1회 + 월 1회)이 KIS chk-holiday opnd_yn='N' 을
# krxHolidayRepo patch(addedBy:'sync')로 등록 → STATIC ∪ patch 활성 Set 에 병합한다.
# KIS docstring "가급적 1일 1회 호출" → 이미 등록된 연도는 KIS 호출 없이 skip(연 1~2콜).
# KIS 실패 시 STATIC fallback 유지(불변식 #6 — provider 장애 ≠ 약세 신호).
# default OFF(미설정/false) → KIS sync 잡 no-op early return(byte-equivalent, 즉시 1줄 롤백).
# ※ marketClock HOLIDAY_CACHE 분기(평일 휴장 인지)는 본 ENV 와 직교 — STATIC Set 기반 항상 동작.
KIS_HOLIDAY_CALENDAR_ENABLED=false

# ──────────────────────────────────────────────
# [ADR-0567] scan 세션 분류 wall-clock stale 교정 (permissive — false-CLOSED 해소)
# ──────────────────────────────────────────────
# true 시 resolveScanMarketSessionView 가 평일 장중(wall-clock=REGULAR_OPEN + KRX 거래일)인데
# 상류 macro 스냅샷이 stale CLOSED/POST_CLOSE 세션을 주면 REGULAR_OPEN 으로 신뢰 교정한다.
# KRX 거래일 판정은 krxTradingCalendar.isKrxTradingDay(→ krxHolidays SSOT, ADR-0559) 위임 →
# 공휴일(예 2026-06-03 지방선거)은 교정 안 함(CLOSED/POST_CLOSE 유지). 장외 wall-clock(POST_CLOSE/
# CLOSED)·주말·진짜 pre/after-market 은 교정 대상 아님.
# default OFF(미설정/false) → byte-equivalent: 세션 분류 기존 동작 그대로, live 게이팅 불변.
# ON 은 live 게이팅 permissive 방향(장중 false-CLOSED 해소) — 운영자가 shadow 검증 후 활성화 권장.
SCAN_SESSION_WALLCLOCK_CORRECTION_ENABLED=false

# ──────────────────────────────────────────────
# [ADR-0547 §D] 프로덕션 shadow A/B 계측 (Yahoo vs KIS Gate quote 실측 델타 수집)
# ──────────────────────────────────────────────
# true 시 풀스캔 survivor 중 top-N(=30) 후보에 대해 KIS-first Gate quote 를 *병행 평가* 하여
# Yahoo-vs-KIS score/signal/MTAS 델타를 [KIS_SHADOW_AB] 구조화 1라인/심볼로 로깅한다(운영자가
# ~20거래일 노이즈밴드 확정 → flag flip 결정 데이터). 결정 미반영(executionImpact=NONE) — 후보집합/
# 점수/주문에 0 영향(순수 로깅, 불변식 #8 shadow≠live). KIS 조회 실패는 약세 신호로 변환하지 않음
# (불변식 #6 providerIssue≠marketSignal). KIS 호출은 fetchTechnicalQuoteByCode 6h 캐시 재사용(quota bound).
# default OFF(미설정/false) → byte-equivalent: 계측 dormant, KIS 신규호출 0콜, 스캔 동작·로그 불변.
# KIS_OHLCV_PRIMARY_ENABLED 와 별개 flag(상호 무관) — 본 스위치는 계측만, 결정 경로 0줄 변경.
KIS_SHADOW_AB_ENABLED=false

# ──────────────────────────────────────────────
# [ADR-0549] Market Rally Search Lens (추천/관측 전용 read-model)
# ──────────────────────────────────────────────
# true 시 buildMarketRallyLens 가 snapshot/macroState 파생값만으로 시장 급등 lens 를 산출한다.
# 자동매매(signalScanner/gates/buyPipeline)와 물리적으로 분리된 read-model — 주문 생성 0건,
# executionImpact=NONE. PR-1 활성 조건은 1(KOSPI 당일+1.5%)·4(외국인 5일 순매수)·6(20일 추세+당일 반등).
# providerIssue/입력 부재 → enabled=false(불변식 #6, bullish/bearish 변환 금지).
# default OFF(미설정/false) → DISABLED 상수 반환, ScanSummary 가산 필드 undefined(byte-equivalent, 즉시 1줄 롤백).
MARKET_RALLY_LENS_ENABLED=false

# ──────────────────────────────────────────────
# [ADR-0556 / ADR-0557] Unified SourceSnapshot factory 활성화 (per-symbol 일괄 수집 + per-field freshness)
# ──────────────────────────────────────────────
# true 시 signalScanner 가 buyList loop 전에 SymbolDataCollector(collectUnifiedSnapshot)로
# 후보 종목당 1회 KIS 4 엔드포인트를 일괄 수집하고, per-field freshness/providerIssue(DataHealth 매핑)를
# 산출해 진단/관찰(observability) 로 노출한다 — gate 점수·confidence·executionPermission·주문 영향 0.
# default OFF(미설정/false) → 기존 per-gate 개별 fetch 경로 100% 유지, freshness 미산출(byte-equivalent).
# Shadow A/B 승격(ADR-0557 Consumer Contract 검증) 전까지 OFF 유지. =false 1줄 즉시 롤백.
USE_UNIFIED_SOURCE_SNAPSHOT=false
